#!/usr/bin/env bash
# Purpose: Map Pedalboard MIDI Controller CC events to local shell commands.
# Usage: pedalboard-midi-actions [--list] [--port ALSA_PORT] [--profile PROFILE] [--config PATH] [--channel-base 0|1] [--dry-run]

set -euo pipefail

prog=${0##*/}
default_config="${XDG_CONFIG_HOME:-"$HOME/.config"}/dotfiles/pedalboard-midi-actions.desktop.tsv"
config=${PEDALBOARD_MIDI_ACTIONS_CONFIG:-"$default_config"}
config_explicit=0
profile=${PEDALBOARD_MIDI_ACTIONS_PROFILE:-}
port=${PEDALBOARD_MIDI_ACTIONS_ALSA_PORT:-}
port_locked=0
reconnect_delay=${PEDALBOARD_MIDI_RECONNECT_DELAY:-2}
channel_base=${PEDALBOARD_MIDI_ACTIONS_CHANNEL_BASE:-0}
dry_run=0
feedback_command=${PEDALBOARD_MIDI_FEEDBACK_COMMAND:-}
desktop_event_command=${PEDALBOARD_MIDI_DESKTOP_EVENT_COMMAND:-desktop-action-event}
profiles_command=${PEDALBOARD_MIDI_PROFILES_COMMAND:-}
shift_threshold=${PEDALBOARD_MIDI_SHIFT_THRESHOLD:-21}
teleprompter_scroll_fifo=${DOTFILES_TELEPROMPTER_SCROLL_FIFO:-"${XDG_RUNTIME_DIR:-/tmp}/dotfiles-teleprompter-scroll.fifo"}
teleprompter_scroll_deadzone=${DOTFILES_TELEPROMPTER_DEADZONE:-$shift_threshold}
teleprompter_scroll_fast_threshold=${DOTFILES_TELEPROMPTER_FAST_THRESHOLD:-64}
teleprompter_scroll_last_value=
teleprompter_scroll_last_level=
teleprompter_step_hold_ms=${DOTFILES_TELEPROMPTER_HOLD_MS:-2000}
teleprompter_step_interval_ms=${DOTFILES_TELEPROMPTER_STEP_MS:-200}
teleprompter_step_hold_s=
teleprompter_step_interval_s=
teleprompter_step_pid=
pedalboard_profile=unknown
pedalboard_continuous=0
pedalboard_switch1=0
pedalboard_switch2=0
last_desktop_layer=
desktop_midi_channel=

usage() {
  cat <<EOF
Usage: $prog [OPTIONS]

Listen to Pedalboard MIDI Controller CC events and dispatch configured commands.
The current pedalboard state is also published to keyboard-midi-controller for TFT feedback when available.

Options:
  --list             List visible ALSA sequencer ports.
  --port PORT        Read a specific ALSA sequencer port, for example 28:0.
  --profile PROFILE  Read mappings from pedalboard-midi-actions.PROFILE.tsv.
  --config PATH      Read mappings from PATH. Default: $default_config
  --channel-base 0|1 Interpret aseqdump channels as zero- or one-based. Default: $channel_base
  --dry-run          Print matching commands instead of executing them.
  -h, --help         Show this help.

Config format:
  CHANNEL CC EDGE COMMAND...

Edges:
  press    Match values >= 64.
  release  Match values < 64.
  any      Match every value change.
  shift-press
           Match press while the continuous desktop pedal is >= $shift_threshold.
  shift-release
           Match release while the continuous desktop pedal is >= $shift_threshold.

Example:
  16 80 press wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
EOF
}

log() {
  printf '%s: %s\n' "$prog" "$*" >&2
}

die() {
  log "$*"
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

list_ports() {
  require_cmd aseqdump
  aseqdump -l || true
}

detect_port() {
  aseqdump -l 2>/dev/null | awk '
    $1 ~ /^[0-9]+:[0-9]+$/ {
      line = tolower($0)
      if (line ~ /arduino/ && line ~ /micro/) {
        print $1
        exit
      }
    }
  '
}

resolve_profiles_command() {
  if [ -n "$profiles_command" ]; then
    printf '%s\n' "$profiles_command"
    return 0
  fi

  local installed="$HOME/.local/bin/pedalboard-midi-profiles"
  if [ -x "$installed" ]; then
    printf '%s\n' "$installed"
    return 0
  fi

  local repo="$HOME/dotfiles/audio/dot-local/bin/pedalboard-midi-profiles"
  if [ -x "$repo" ]; then
    printf '%s\n' "$repo"
    return 0
  fi

  command -v pedalboard-midi-profiles 2>/dev/null || die "pedalboard-midi-profiles not found"
}

profile_row() {
  "$(resolve_profiles_command)" get "$1"
}

validate_channel_base() {
  case "$channel_base" in
    0|1) ;;
    *) die "--channel-base must be 0 or 1" ;;
  esac
}

validate_shift_threshold() {
  [[ $shift_threshold =~ ^[0-9]+$ ]] && [ "$shift_threshold" -ge 0 ] && [ "$shift_threshold" -le 127 ] || die "PEDALBOARD_MIDI_SHIFT_THRESHOLD must be 0-127"
}

validate_teleprompter_deadzone() {
  [[ $teleprompter_scroll_deadzone =~ ^[0-9]+$ ]] && [ "$teleprompter_scroll_deadzone" -ge 0 ] && [ "$teleprompter_scroll_deadzone" -le 127 ] || die "DOTFILES_TELEPROMPTER_DEADZONE must be 0-127"
}

validate_teleprompter_fast_threshold() {
  [[ $teleprompter_scroll_fast_threshold =~ ^[0-9]+$ ]] && [ "$teleprompter_scroll_fast_threshold" -ge 0 ] && [ "$teleprompter_scroll_fast_threshold" -le 127 ] || die "DOTFILES_TELEPROMPTER_FAST_THRESHOLD must be 0-127"
}

validate_teleprompter_step_hold() {
  [[ $teleprompter_step_hold_ms =~ ^[0-9]+$ ]] && [ "$teleprompter_step_hold_ms" -ge 200 ] && [ "$teleprompter_step_hold_ms" -le 10000 ] || die "DOTFILES_TELEPROMPTER_HOLD_MS must be 200-10000"
}

validate_teleprompter_step_interval() {
  [[ $teleprompter_step_interval_ms =~ ^[0-9]+$ ]] && [ "$teleprompter_step_interval_ms" -ge 50 ] && [ "$teleprompter_step_interval_ms" -le 2000 ] || die "DOTFILES_TELEPROMPTER_STEP_MS must be 50-2000"
}

validate_reconnect_delay() {
  [[ $reconnect_delay =~ ^[0-9]+$ ]] && [ "$reconnect_delay" -ge 1 ] && [ "$reconnect_delay" -le 60 ] || die "PEDALBOARD_MIDI_RECONNECT_DELAY must be 1-60 seconds"
}

resolve_config() {
  [ -n "$profile" ] || return 0
  [[ $profile =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid profile name: $profile"

  local profile_data
  profile_data=$(profile_row "$profile") || die "unknown profile name: $profile"
  IFS=$'\t' read -r _profile_id profile_name _profile_label _midi_channel _continuous_cc _switch1_cc _switch2_cc _switch1_mode _switch2_mode _mapper_profile _aliases <<<"$profile_data"
  profile=$profile_name

  [ "$config_explicit" -eq 0 ] || return 0
  config="${XDG_CONFIG_HOME:-"$HOME/.config"}/dotfiles/pedalboard-midi-actions.${profile}.tsv"
}

resolve_feedback_command() {
  if [ -n "$feedback_command" ]; then
    printf '%s\n' "$feedback_command"
    return 0
  fi

  cached="${XDG_CACHE_HOME:-"$HOME/.cache"}/dotfiles/keyboard-midi-controller/keyboard-midi-controller"
  if [ -x "$cached" ]; then
    printf '%s\n' "$cached"
    return 0
  fi

  wrapper="$HOME/bin/keyboard-midi-controller"
  if [ -x "$wrapper" ]; then
    printf '%s\n' "$wrapper"
  fi
  return 0
}

declare -A actions
declare -A pedalboard_control_profiles
declare -A pedalboard_control_fields

load_profile_controls() {
  local profile_id profile_name profile_label channel continuous_cc switch1_cc switch2_cc switch1_mode switch2_mode mapper_profile aliases
  while IFS=$'\t' read -r profile_id profile_name profile_label channel continuous_cc switch1_cc switch2_cc switch1_mode switch2_mode mapper_profile aliases; do
    pedalboard_control_profiles["$channel:$continuous_cc"]=$profile_name
    pedalboard_control_fields["$channel:$continuous_cc"]=continuous
    pedalboard_control_profiles["$channel:$switch1_cc"]=$profile_name
    pedalboard_control_fields["$channel:$switch1_cc"]=switch1
    pedalboard_control_profiles["$channel:$switch2_cc"]=$profile_name
    pedalboard_control_fields["$channel:$switch2_cc"]=switch2
    if [ "$profile_name" = desktop ]; then
      desktop_midi_channel=$channel
    fi
  done < <("$(resolve_profiles_command)" list)
}

load_config() {
  [ -f "$config" ] || die "missing config file: $config"

  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    [[ $line =~ [^[:space:]] ]] || continue

    read -r channel controller edge command <<<"$line"
    [ -n "${channel:-}" ] && [ -n "${controller:-}" ] && [ -n "${edge:-}" ] && [ -n "${command:-}" ] || die "invalid config line: $line"
    [[ $channel =~ ^[0-9]+$ ]] && [ "$channel" -ge 1 ] && [ "$channel" -le 16 ] || die "invalid channel in line: $line"
    [[ $controller =~ ^[0-9]+$ ]] && [ "$controller" -ge 0 ] && [ "$controller" -le 127 ] || die "invalid CC in line: $line"
    case "$edge" in
      press|release|any|shift-press|shift-release) ;;
      *) die "invalid edge in line: $line" ;;
    esac

    actions["$channel:$controller:$edge"]=$command
  done <"$config"

  [ "${#actions[@]}" -gt 0 ] || die "config has no actions: $config"
}

run_action() {
  local channel=$1
  local controller=$2
  local value=$3
  local edge=$4
  local command=${actions["$channel:$controller:$edge"]:-}

  [ -n "$command" ] || return 0

  if [ "$dry_run" -eq 1 ]; then
    printf 'match channel=%s cc=%s value=%s edge=%s command=%s\n' "$channel" "$controller" "$value" "$edge" "$command"
    return 0
  fi

  if [ "$command" = teleprompter-scroll ]; then
    update_teleprompter_scroll "$value"
    return 0
  fi

  if [ "$command" = teleprompter-scroll-step ]; then
    teleprompter_step_event "$edge"
    return 0
  fi

  PEDALBOARD_MIDI_CHANNEL=$channel \
    PEDALBOARD_MIDI_CC=$controller \
    PEDALBOARD_MIDI_VALUE=$value \
    PEDALBOARD_MIDI_EDGE=$edge \
    bash -lc "$command" &
}

update_teleprompter_scroll() {
  local value=$1
  local fifo_fd=

  if [ "$value" -le "$teleprompter_scroll_deadzone" ]; then
    value=0
  fi

  [ "$value" != "$teleprompter_scroll_last_value" ] || return 0
  teleprompter_scroll_last_value=$value

  [ -p "$teleprompter_scroll_fifo" ] || return 0
  if exec {fifo_fd}<>"$teleprompter_scroll_fifo"; then
    printf '%s\n' "$value" >&"$fifo_fd" || true
    exec {fifo_fd}>&-
  fi
}

teleprompter_step_send() {
  local fifo_fd=
  [ -p "$teleprompter_scroll_fifo" ] || return 0
  if exec {fifo_fd}<>"$teleprompter_scroll_fifo"; then
    printf 'step\n' >&"$fifo_fd" || true
    exec {fifo_fd}>&-
  fi
}

teleprompter_step_publish() {
  local command_path state=$1
  command_path=$(resolve_feedback_command)
  [ -n "$command_path" ] || return 0
  "$command_path" desktop-action-state 2 LINE "$state" >/dev/null 2>&1 || true
}

teleprompter_step_resolve_timing() {
  teleprompter_step_hold_s=$(awk -v ms="$teleprompter_step_hold_ms" 'BEGIN { printf "%.3f", ms / 1000 }')
  teleprompter_step_interval_s=$(awk -v ms="$teleprompter_step_interval_ms" 'BEGIN { printf "%.3f", ms / 1000 }')
}

teleprompter_step_loop() {
  sleep "$teleprompter_step_hold_s"
  teleprompter_step_publish HOLD
  while :; do
    teleprompter_step_send
    sleep "$teleprompter_step_interval_s"
  done
}

teleprompter_step_start() {
  teleprompter_step_send
  teleprompter_step_publish TAP
  [ -n "$teleprompter_step_pid" ] && return 0
  teleprompter_step_loop &
  teleprompter_step_pid=$!
}

teleprompter_step_stop() {
  local pid=$teleprompter_step_pid
  teleprompter_step_pid=
  [ -n "$pid" ] || return 0
  stop_background_pid "$pid"
  teleprompter_step_publish IDLE
}

teleprompter_step_event() {
  if [ "$1" = press ]; then
    teleprompter_step_start
  else
    teleprompter_step_stop
  fi
}

cleanup_teleprompter_step() {
  local pid=$teleprompter_step_pid
  teleprompter_step_pid=
  [ -n "$pid" ] || return 0
  stop_background_pid "$pid"
}

publish_initial_teleprompter_step_state() {
  [ "$profile" = obs-mouseless-setup ] || return 0
  teleprompter_step_publish IDLE
}

publish_pedalboard_state_values() {
  local profile_value=$1
  local continuous_value=$2
  local switch1_value=$3
  local switch2_value=$4
  local command_path

  command_path=$(resolve_feedback_command)
  [ -n "$command_path" ] || return 0

  "$command_path" pedalboard-state "$profile_value" "$continuous_value" "$switch1_value" "$switch2_value" >/dev/null 2>&1 || true
}

publish_pedalboard_state() {
  local continuous_value=$pedalboard_continuous

  if [ "$pedalboard_profile" = obs-mouseless-setup ]; then
    continuous_value=$(teleprompter_scroll_level_value "$(teleprompter_scroll_level "$pedalboard_continuous")")
  fi

  publish_pedalboard_state_values "$pedalboard_profile" "$continuous_value" "$pedalboard_switch1" "$pedalboard_switch2"
}

teleprompter_scroll_level() {
  local value=$1

  if [ "$value" -le "$teleprompter_scroll_deadzone" ]; then
    printf '0\n'
  elif [ "$value" -le "$teleprompter_scroll_fast_threshold" ]; then
    printf '1\n'
  else
    printf '2\n'
  fi
}

teleprompter_scroll_level_value() {
  case "$1" in
    0) printf '0\n' ;;
    1) printf '64\n' ;;
    *) printf '127\n' ;;
  esac
}

publish_teleprompter_scroll_state() {
  local level
  local feedback_value

  level=$(teleprompter_scroll_level "$1")
  [ "$level" != "$teleprompter_scroll_last_level" ] || return 0
  teleprompter_scroll_last_level=$level
  feedback_value=$(teleprompter_scroll_level_value "$level")

  publish_pedalboard_state_values "$pedalboard_profile" "$feedback_value" "$pedalboard_switch1" "$pedalboard_switch2"
}

publish_desktop_layer_state() {
  [ "$pedalboard_profile" = desktop ] || return 0
  command -v "$desktop_event_command" >/dev/null 2>&1 || return 0

  local next_layer=BASE

  if [ "$pedalboard_continuous" -ge "$shift_threshold" ]; then
    next_layer=SHIFT
  fi

  [ "$next_layer" != "$last_desktop_layer" ] || return 0
  last_desktop_layer=$next_layer
  "$desktop_event_command" desktop.layer "$next_layer" >/dev/null 2>&1 || true
}

sync_initial_pedalboard_state() {
  if command -v pedalboard-midi-profile >/dev/null 2>&1; then
    pedalboard-midi-profile status >/dev/null 2>&1 || true
  fi
}

update_pedalboard_state() {
  local channel=$1
  local controller=$2
  local value=$3
  local key="$channel:$controller"
  local profile_name=${pedalboard_control_profiles["$key"]:-}
  local control_field=${pedalboard_control_fields["$key"]:-}

  [ -n "$profile_name" ] || return 0
  pedalboard_profile=$profile_name

  case "$control_field" in
    continuous) pedalboard_continuous=$value ;;
    switch1) pedalboard_switch1=$value ;;
    switch2) pedalboard_switch2=$value ;;
    *) return 0 ;;
  esac

  if [ "$profile_name" = obs-mouseless-setup ] && [ "$control_field" = continuous ]; then
    publish_teleprompter_scroll_state "$value"
    return 0
  fi

  publish_pedalboard_state
  if [ "$profile_name" = desktop ] && [ "$control_field" = continuous ]; then
    publish_desktop_layer_state
  fi
}

handle_cc() {
  local printed_channel=$1
  local controller=$2
  local value=$3
  local channel=$printed_channel
  local edge=release

  if [ "$channel_base" -eq 0 ]; then
    channel=$((printed_channel + 1))
  fi
  [ "$value" -lt 64 ] || edge=press

  update_pedalboard_state "$channel" "$controller" "$value"

  run_action "$channel" "$controller" "$value" any
  if [ "$channel" = "$desktop_midi_channel" ] && [ "$pedalboard_continuous" -ge "$shift_threshold" ]; then
    run_action "$channel" "$controller" "$value" "shift-$edge"
  else
    run_action "$channel" "$controller" "$value" "$edge"
  fi
}

handle_aseqdump_line() {
  local line=$1

  [[ $line == *"Control change"* ]] || return 0
  if [[ $line =~ Control[[:space:]]change[[:space:]]+([0-9]+),[[:space:]]controller[[:space:]]([0-9]+),[[:space:]]value[[:space:]]([0-9]+) ]]; then
    handle_cc "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
  fi
}

listen_port() {
  local active_port=$1
  local line

  log "listening on ALSA sequencer port $active_port"
  while IFS= read -r line; do
    handle_aseqdump_line "$line"
  done < <(aseqdump -p "$active_port")
}

wait_for_port_visibility_change() {
  local active_port=$1
  local next_port

  while :; do
    sleep "$reconnect_delay"
    next_port=$(detect_port)
    if [ -z "$next_port" ] || [ "$next_port" != "$active_port" ]; then
      printf 'pedalboard port visibility changed: %s -> %s\n' "$active_port" "${next_port:-missing}" >&2
      return 0
    fi
  done
}

stop_background_pid() {
  local pid=${1:-}
  local child
  [ -n "$pid" ] || return 0
  for child in $(pgrep -P "$pid" 2>/dev/null || true); do
    stop_background_pid "$child"
  done
  kill -TERM "$pid" >/dev/null 2>&1 || true
  wait "$pid" >/dev/null 2>&1 || true
}

run_listener_loop() {
  local active_port listener_pid watchdog_pid

  while :; do
    active_port=$port
    if [ -z "$active_port" ]; then
      active_port=$(detect_port)
    fi

    if [ -z "$active_port" ]; then
      list_ports >&2
      log "could not auto-detect Arduino Micro ALSA sequencer port; retrying in ${reconnect_delay}s"
      [ "$dry_run" -eq 0 ] || return 1
      sleep "$reconnect_delay"
      continue
    fi

    if [ "$dry_run" -eq 1 ]; then
      listen_port "$active_port"
      return 0
    fi

    listen_port "$active_port" &
    listener_pid=$!

    wait_for_port_visibility_change "$active_port" &
    watchdog_pid=$!

    wait -n "$listener_pid" "$watchdog_pid" >/dev/null 2>&1 || true
    if kill -0 "$listener_pid" >/dev/null 2>&1; then
      log "MIDI port visibility changed; reconnecting pedalboard listener"
    fi
    stop_background_pid "$listener_pid"
    stop_background_pid "$watchdog_pid"

    [ "$dry_run" -eq 0 ] || return 0
    [ "$port_locked" -eq 1 ] || port=
    sleep "$reconnect_delay"
  done
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --list)
      list_ports
      exit 0
      ;;
    --port)
      [ "$#" -ge 2 ] || die "--port requires a value"
      port=$2
      port_locked=1
      shift 2
      ;;
    --config)
      [ "$#" -ge 2 ] || die "--config requires a value"
      config=$2
      config_explicit=1
      shift 2
      ;;
    --profile)
      [ "$#" -ge 2 ] || die "--profile requires a value"
      profile=$2
      shift 2
      ;;
    --channel-base)
      [ "$#" -ge 2 ] || die "--channel-base requires a value"
      channel_base=$2
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

require_cmd aseqdump
validate_channel_base
validate_shift_threshold
validate_teleprompter_deadzone
validate_teleprompter_fast_threshold
validate_reconnect_delay
validate_teleprompter_step_hold
validate_teleprompter_step_interval
resolve_config
load_profile_controls
load_config
teleprompter_step_resolve_timing
trap cleanup_teleprompter_step EXIT
sync_initial_pedalboard_state
publish_initial_teleprompter_step_state
run_listener_loop
