#
# ~/.bashrc
#

dotfiles_session_env="$HOME/dotfiles/home/lib/session-env.bash"
[ -r "$dotfiles_session_env" ] && . "$dotfiles_session_env"
unset dotfiles_session_env

[[ $- == *i* && -r /usr/share/blesh/ble.sh ]] && source -- /usr/share/blesh/ble.sh --attach=none

if [[ $- != *i* ]]; then
    return
fi

shopt -s expand_aliases

# alias ls='ls --color=auto'
if command -v eza &>/dev/null; then
    alias ls='eza -1 -a -h --git --sort modified -l --icons always --color always'
fi

alias grep='grep --color=auto'

# https://jesrui.sdf-eu.org/remember-all-your-bash-history-forever.html
export HISTTIMEFORMAT='%F %T '
export HISTFILESIZE=-1
export HISTSIZE=-1
export HISTCONTROL=ignoredups
export HISTIGNORE=?:??
# append to history, don't overwrite it
shopt -s histappend
# attempt to save all lines of a multiple-line command in the same history entry
shopt -s cmdhist
# save multi-line commands to the history with embedded newlines
shopt -s lithist

# Clear a terminal screen for real
# https://askubuntu.com/a/684887
alias cls='clear && echo -en "\e[3J"'
alias dd='pkexec --user root pkill -u $USER' # logout to sddm

if [[ ! ${BLE_VERSION-} ]] && command -v fzf &>/dev/null; then
    # Set up fzf key bindings and fuzzy completion when ble.sh is unavailable.
    eval "$(fzf --bash)"
fi

nvim() {
    "$HOME/bin/nvim" "$@"
}

alias agent-tasks='env -u BASH_FUNC_nvim%% "$HOME/bin/agent-tasks"'

if command -v pyenv &>/dev/null; then
    eval "$(pyenv init - bash)"
fi

if command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
fi

if command -v nnn-with-defaults &>/dev/null; then
    alias nnn='nnn-with-defaults'
fi

PS1='[\u@\h \W]\$ '
if [ -n "$NNNLVL" ]; then
    PS1="N$NNNLVL $PS1"
    if command -v kitten &>/dev/null; then
        kitten @ set-colors background='#111827' 2>/dev/null
        trap 'kitten @ set-colors --reset 2>/dev/null' EXIT
    fi
fi

if [[ -n ${NNN_PIPE-} ]]; then
    # https://github.com/jarun/nnn/wiki/Basic-use-cases#sync-subshell-pwd
    nnn_cd() {
        [[ -p ${NNN_PIPE-} ]] || return 0
        printf "%s\0" "0c${PWD}" ! >"${NNN_PIPE}" 2>/dev/null &
    }

    trap nnn_cd EXIT
fi

# Have less display colours.
# from: https://wiki.archlinux.org/index.php/Color_output_in_console#man
export LESS_TERMCAP_mb=$'\e[1;31m'     # begin bold
export LESS_TERMCAP_md=$'\e[1;33m'     # begin blink
export LESS_TERMCAP_so=$'\e[01;44;37m' # begin reverse video
export LESS_TERMCAP_us=$'\e[01;37m'    # begin underline
export LESS_TERMCAP_me=$'\e[0m'        # reset bold/blink
export LESS_TERMCAP_se=$'\e[0m'        # reset reverse video
export LESS_TERMCAP_ue=$'\e[0m'        # reset underline
export GROFF_NO_SGR=1                  # for konsole and gnome-terminal
# https://stackoverflow.com/a/19871578/5353461
export MANPAGER='less -s -M +Gg'
# https://unix.stackexchange.com/q/596473
export LESS=-j10

# https://unix.stackexchange.com/a/684760
_edit_wo_executing() {
    local editor="${EDITOR:-nano}"
    tmpf="$(mktemp).sh"
    printf '%s\n' "$READLINE_LINE" >"$tmpf"
    $editor "$tmpf"
    READLINE_LINE="$(<"$tmpf")"
    READLINE_POINT="${#READLINE_LINE}"
    rm "$tmpf"
}

bind -x '"\C-x\C-e":_edit_wo_executing'

[[ ! ${BLE_VERSION-} ]] || ble-attach
