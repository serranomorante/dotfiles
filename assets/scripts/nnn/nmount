#!/usr/bin/env sh

# Description: Toggle mount status of a device using udisksctl.
#              If the device is not mounted, it will be mounted.
#              If the device is mounted, it will be unmounted and powered down.
#
#              Local dotfiles fork of the upstream nnn `nmount` plugin:
#                - The device listing shows the FSTYPE and LABEL columns so
#                  labeled volumes are recognizable at a glance.
#                - The entered token is resolved by filesystem LABEL first
#                  (including labels with spaces/slashes, which udev escapes in
#                  /dev/disk/by-label) and falls back to a plain device name
#                  (e.g. sdXn) only when no volume carries that label.
#                - Everything goes through udisksctl (never pmount), so volumes
#                  mount under /run/media/$USER/<label> like the desktop file
#                  manager and encrypted volumes (LUKS and BitLocker) unlock
#                  interactively.
#
# Dependencies: lsblk, udisks2
#
# Usage: Runs `lsblk` on 'l', exits on 'Return`.
#
# Notes:
#   - The script uses Linux-specific lsblk to list block devices. Alternatives:
#       macOS: "diskutil list"
#       BSD: "geom disk list"
#   - The script uses udisksctl (from udisks2) to mount, unlock and power down
#     devices. This is also Linux-specific.
#
# Shell: POSIX compliant (with a bash-compatible printf for \xNN decoding)
# Author: Arun Prakash Jana

prompt="device name or label [e.g. sdXn / dev4] ('l'ist, 'q'uit): "

# Columns to list; FSTYPE and LABEL are added over the upstream default so a
# labeled device can be selected by its label instead of its kernel name.
lsblk_list="lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINTS"

# Decode udev \xNN hex escapes used in /dev/disk/by-label names (space -> \x20,
# slash -> \x2f, etc.). udev only emits \xNN escapes, so after neutralizing any
# literal percent the string is safe to feed to printf as a format.
udev_unescape() {
    _s="$1"
    _s="${_s//%/%%}"
    printf "$_s"
}

# Resolve the entered token to a kernel device name. Match a filesystem LABEL
# first: try the direct by-label symlink, then scan by-label decoding udev
# escaping so labels with spaces or slashes match too. When nothing matches,
# keep the token as-is so it is treated as a plain device name. Sets `dev`.
resolve_dev() {
    dev="$1"
    if [ -e "/dev/disk/by-label/$1" ]; then
        dev="$(basename "$(readlink -f "/dev/disk/by-label/$1")")"
        return
    fi
    [ -d /dev/disk/by-label ] || return
    for _link in /dev/disk/by-label/*; do
        [ -e "$_link" ] || continue
        if [ "$(udev_unescape "$(basename "$_link")")" = "$1" ]; then
            dev="$(basename "$(readlink -f "$_link")")"
            return
        fi
    done
}

$lsblk_list

printf "\nEnsure you aren't still in the mounted device.\n"
printf "%s" "$prompt"
read -r dev

while [ -n "$dev" ]; do
    if [ "$dev" = "l" ]; then
        $lsblk_list
    elif [ "$dev" = "q" ]; then
        exit
    else
        resolve_dev "$dev"

        # Filesystem type of the container itself (not its children).
        fstype="$(lsblk -dno FSTYPE "/dev/$dev" 2>/dev/null | sed "/^$/d" | head -n1)"
        encrypted=0
        case "$fstype" in
            crypto_LUKS | BitLocker) encrypted=1 ;;
        esac

        if grep -qs "$dev " /proc/mounts || [ -n "$(lsblk -n "/dev/$dev" -o MOUNTPOINT)" ]; then
            sync "$(lsblk -n "/dev/$dev" -o MOUNTPOINT | sed "/^$/d")"
            if [ "$encrypted" -eq 1 ]; then
                # Encrypted: unmount the cleartext mapping, then lock the container.
                dev_map="$(udisksctl info -b "/dev/$dev" | grep "CleartextDevice" | grep -o "dm_2d[[:digit:]]*" | sed "s/_2d/-/")"
                udisksctl unmount -b "/dev/$dev_map" --no-user-interaction >/dev/null
                exit_code="$?"
                udisksctl lock -b "/dev/$dev" --no-user-interaction >/dev/null
            else
                udisksctl unmount -b "/dev/$dev" --no-user-interaction >/dev/null
                exit_code="$?"
            fi
            if [ "$exit_code" -eq 0 ]; then
                echo "/dev/$dev unmounted."
                if udisksctl power-off -b "/dev/$dev" --no-user-interaction; then
                    echo "/dev/$dev ejected."
                fi
            fi
        elif [ -b "/dev/$dev" ]; then
            if [ "$encrypted" -eq 1 ]; then
                # Encrypted: unlock interactively (udisksctl prompts for the LUKS
                # or BitLocker passphrase), then mount the cleartext device.
                clear_dev="$(udisksctl unlock -b "/dev/$dev" | sed -n "s/^Unlocked .* as \(.*\)\.\$/\1/p")"
                if [ -n "$clear_dev" ]; then
                    udisksctl mount -b "$clear_dev" --no-user-interaction >/dev/null
                    exit_code="$?"
                else
                    exit_code=1
                fi
            else
                udisksctl mount -b "/dev/$dev" --no-user-interaction >/dev/null
                exit_code="$?"
            fi
            if [ "$exit_code" -eq 0 ]; then
                sleep 1
                echo "/dev/$dev mounted to $(lsblk -n "/dev/$dev" -o MOUNTPOINT | sed "/^$/d")."
            fi
        else
            echo "/dev/$dev does not exist or is not a block device."
        fi
    fi

    echo
    printf "%s" "$prompt"
    read -r dev
done
