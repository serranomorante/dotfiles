#!/bin/sh

# Purpose: Run nnn with the repository's standard flags and environment.
# Usage: nnn-with-defaults [--open-in-nvim] [nnn-args...]
# Notes: Use --open-in-nvim for terminal panels/tasks that should hand file
# opens back to the current Neovim instance through open_in_nvim.

open_in_nvim=0

while [ "$#" -gt 0 ]; do
    case $1 in
    --open-in-nvim)
        open_in_nvim=1
        shift
        ;;
    --)
        shift
        break
        ;;
    *)
        break
        ;;
    esac
done

if [ "$open_in_nvim" = 1 ]; then
    export EDITOR="open_in_nvim nnn_explorer"
    export VISUAL="open_in_nvim nnn_explorer"
fi

script_path=$(readlink -f -- "$0" 2>/dev/null || printf '%s\n' "$0")
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)

NNN_PLUG_PREVIEW_TUI='p:preview-tui'                     # Opens a multimedia preview for the currently hovered file in nnn
NNN_PLUG_FIND_IN_NVIM='f:!open_in_nvim nnn_search Find*' # Integrates with neovim to find files into the path that's currently hover in nnn
NNN_PLUG_GREP_IN_NVIM='g:!open_in_nvim nnn_search Grep*' # Integrates with neovim to grep into the path that's currently hover in nnn
# nnn only sets NNNLVL around its built-in spawn-shell, never for plugin-run
# commands, so we export it ourselves (arithmetic treats unset as 0, and stays
# nesting-aware when nnn is launched from within one of these subshells).
NNN_PLUG_SYNC_SUBSHELL_PWD='s:!NNNLVL=$((NNNLVL+1)) bash -i*'                  # Opens a subshell inside nnn and syncs the pwd when you exit
NNN_PLUG_CD_TO='l:cdto'                                                        # Directly change the pwd by pasting a path into the cdto input
NNN_PLUG_QUICK_ACCESS_TERMINAL_PATH_SYNC="c:!$script_dir/nnn-quick-access-cd*" # Integrates with neovim to change the nnn pwd based on the current open file
NNN_PLUG_NMOUNT='t:nmount'
default_nnn_plug="$NNN_PLUG_SYNC_SUBSHELL_PWD;$NNN_PLUG_PREVIEW_TUI;$NNN_PLUG_CD_TO;$NNN_PLUG_FIND_IN_NVIM;$NNN_PLUG_GREP_IN_NVIM;$NNN_PLUG_NMOUNT"

if [ -z "${NNN_PLUG+x}" ]; then
    export NNN_PLUG=$default_nnn_plug
fi

if [ -n "${NNN_QUICK_ACCESS_TARGET:-}" ]; then
    case ";$NNN_PLUG;" in
    *";c:"*) ;;
    *) export NNN_PLUG="$NNN_PLUG;$NNN_PLUG_QUICK_ACCESS_TERMINAL_PATH_SYNC" ;;
    esac
fi

if [ -z "${NNN_TRASH+x}" ]; then
    export NNN_TRASH=trash
fi

if [ -z "${NNN_PREVIEWIMGPROG+x}" ] && [ "${TERM:-}" = "xterm-kitty" ] && command -v chafa >/dev/null 2>&1; then
    export NNN_PREVIEWIMGPROG="chafa -f kitty --scale max --animate=off --clear"
fi

session_name="$PWD-${KITTY_NNN_INSTANCE_ROLE:-session}"

exec nnn -SGJRHdaAog -s "$(systemd-escape -p $session_name)" -Tt "$@"
