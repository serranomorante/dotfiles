#!/bin/sh
# Purpose: Regenerate dnsmasq's local-domain config so `.local` aliases resolve
# to the machine's current LAN address, then reload dnsmasq if it changed.
#
# The aliases come from /etc/hosts (managed by the media-proxy role); dnsmasq
# serves them with the default-route IPv4 instead of 127.0.0.1, so LAN devices
# and via's nginx (which uses this dnsmasq as its resolver) can reach the
# self-hosted services by name regardless of DHCP reassignment.
#
# Triggered on boot, hourly by a systemd timer, and by a NetworkManager
# dispatcher hook on address changes.

set -eu

CONF=/etc/dnsmasq.d/lan.conf

get_lan_ip() {
    ip -4 route get 1.1.1.1 2>/dev/null |
        awk '{ for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit } }'
}

lan_ip=$(get_lan_ip) || true
if [ -z "${lan_ip:-}" ]; then
    lan_ip=$(ip -o -4 addr show |
        awk '$2 !~ /^(lo|docker|br-|veth|wine)/ && $4 ~ /^[0-9]+\./ { print $4; exit }' |
        cut -d/ -f1)
fi
[ -n "${lan_ip:-}" ] || exit 1

# Collect the non-localhost hostnames that contain a dot from /etc/hosts.
aliases=$(awk '
    $1 ~ /^[0-9.]+$/ && $2 ~ /\./ {
        for (i = 2; i <= NF; i++) if ($i != "localhost") print $i
    }' /etc/hosts | sort -u)

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

mkdir -p /etc/dnsmasq.d

{
    echo "# Generated by dotfiles-lan-dns; do not edit."
    echo "port=53"
    echo "listen-address=0.0.0.0"
    echo "bind-interfaces"
    echo "domain-needed"
    echo "bogus-priv"
    echo "no-hosts"
    echo "no-resolv"
    awk '/^nameserver/ { print "server=" $2 }' /etc/resolv.conf
    for alias in $aliases; do
        echo "address=/$alias/$lan_ip"
    done
} > "$tmp"

mode=$(stat -c %a "$CONF" 2>/dev/null || true)
if cmp -s "$tmp" "$CONF" && [ "$mode" = "644" ]; then
    # Config file already matches. dnsmasq only reads its main config at
    # startup (SIGHUP reload only re-reads /etc/hosts and addn-hosts files), so
    # restart it when the running process predates the config file.
    pid=$(systemctl show -p MainPID --value dnsmasq)
    proc_start=0
    if [ -n "${pid:-}" ] && [ "$pid" != "0" ] && [ -e "/proc/$pid" ]; then
        proc_start=$(stat -c %Y "/proc/$pid")
    fi
    if [ "$(stat -c %Y "$CONF")" -le "$proc_start" ]; then
        echo "changed=0"
        exit 0
    fi
    systemctl restart dnsmasq
    echo "changed=1"
    exit 0
fi

cp "$tmp" "$CONF"
# dnsmasq drops privileges to its own user after startup and re-reads config on
# reload, so the file must be world-readable (0600 would keep the old config).
chmod 0644 "$CONF"
# dnsmasq's SIGHUP reload only re-reads /etc/hosts and addn-hosts files, not the
# main config, so a full restart is required to apply address= / no-hosts.
systemctl restart dnsmasq
echo "changed=1"
