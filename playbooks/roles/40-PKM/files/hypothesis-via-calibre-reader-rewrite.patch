 from via.services.youtube import YouTubeService
 
 
+_CALIBRE_READER_URL = re.compile(r"^/(show|read)/(?P<id>[^/]+)/(?P<fmt>[^/?#]+)")
+
+
+def rewrite_calibre_reader_url(url):
+    """Rewrite calibre-web reader URLs to the raw download URL.
+
+    calibre-web serves `/show/<id>/<format>` and `/read/<id>/<format>` as HTML
+    reader pages, so via would proxy them as HTML and the document would render
+    in the browser's native viewer, without the Hypothesis sidebar. Rewriting
+    them to `/download/<id>/<format>` lets via detect the raw PDF and serve its
+    own viewer instead.
+    """
+    parts = urlparse(url)
+    if "calibre-web" not in (parts.hostname or ""):
+        return url
+    match = _CALIBRE_READER_URL.match(parts.path)
+    if not match:
+        return url
+    new_path = f"/download/{match.group('id')}/{match.group('fmt')}"
+    return parts._replace(path=new_path).geturl()
+
+
