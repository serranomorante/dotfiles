#!/bin/sh
# Purpose: Set the kernel SMT (hyper-threading) state via sysfs.
# Usage: smt-control on|off
set -eu

sysfs_root="${SMT_CONTROL_SYSFS_ROOT:-/sys}"
smt_control="$sysfs_root/devices/system/cpu/smt/control"
mode="${1:-}"

case "$mode" in
  on|off) ;;
  *)
    printf 'usage: smt-control on|off\n' >&2
    exit 2
    ;;
esac

if [ ! -e "$smt_control" ]; then
  printf 'smt-control: %s not present; nothing to do\n' "$smt_control" >&2
  exit 0
fi
if [ ! -w "$smt_control" ]; then
  printf 'smt-control: %s is not writable\n' "$smt_control" >&2
  exit 1
fi
printf '%s\n' "$mode" >"$smt_control"
