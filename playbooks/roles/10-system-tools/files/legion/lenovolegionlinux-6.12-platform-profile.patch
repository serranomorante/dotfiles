diff --git a/legion-laptop.c b/legion-laptop.c
--- a/legion-laptop.c
+++ b/legion-laptop.c
@@ -78,6 +78,16 @@
 #include <linux/wmi.h>
 #include <linux/version.h>
 
+/*
+ * DOTFILES_PLATFORM_PROFILE_COMPAT:
+ * LenovoLegionLinux git uses platform-profile constants added after the
+ * workstation's linux-rt-lts 6.12 kernel. Older kernels expose the custom
+ * Legion mode as balanced-performance and do not have max-power.
+ */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 18, 0)
+#define PLATFORM_PROFILE_CUSTOM PLATFORM_PROFILE_BALANCED_PERFORMANCE
+#endif
+
 MODULE_LICENSE("GPL");
 MODULE_AUTHOR("johnfan");
 MODULE_DESCRIPTION("Lenovo Legion laptop extras");
@@ -5409,11 +5419,13 @@ static int legion_platform_profile_init(struct legion_private *priv)
 		set_bit(PLATFORM_PROFILE_CUSTOM,
 			priv->platform_profile_handler.choices);
 	}
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 19, 0)
 	if (priv->conf->has_extreme_powermode &&
 	    priv->conf->access_method_powermode == ACCESS_METHOD_WMI) {
 		set_bit(PLATFORM_PROFILE_MAX_POWER,
 			priv->platform_profile_handler.choices);
 	}
+#endif
 #endif
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 14, 0)
