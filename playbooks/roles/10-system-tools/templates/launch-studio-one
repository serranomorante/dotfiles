#!/usr/bin/env bash
# {{ ansible_managed }}
# Purpose: launch Studio One 7 inside a nested weston (X11 backend) because the
# PreSonus Linux build only runs as a Wayland client and the KDE session is X11,
# with the same low-latency PipeWire profile as the REAPER/Ardour launchers
# (quantum from audio-latency defaults/state, default 256 @ 48 kHz ≈ 5.3 ms)
# plus CPU/platform boost for the lifetime of the session, restored on exit.
# Usage: launch-studio-one [file...]
set -euo pipefail

BIN="/opt/PreSonus/Studio One 7/Studio One"
if [ ! -x "$BIN" ]; then
    echo "Studio One is not installed (missing $BIN)" >&2
    exit 1
fi
if ! command -v weston >/dev/null 2>&1; then
    echo "weston is not installed; re-run the audio tools playbook" >&2
    exit 1
fi
: "${DISPLAY:?Studio One needs a Wayland host inside an X session}"

governor_boost_started=0
platform_profile_boost_started=0
smt_boost_started=0

platform_profile_boost_start() {
  # Raise the platform firmware profile while Studio One runs. This controls the
  # laptop-level power/thermal policy, separate from the CPU governor below.
  if command -v powerprofilesctl >/dev/null 2>&1 && powerprofilesctl set performance 2>/dev/null; then
    platform_profile_boost_started=1
  fi
}

platform_profile_boost_stop() {
  if [ "$platform_profile_boost_started" -eq 1 ]; then
    powerprofilesctl set balanced 2>/dev/null || true
    platform_profile_boost_started=0
  fi
}

governor_boost_start() {
  # Raise the CPU governor to performance for low-latency audio while Studio One
  # runs. Authorized for the 'realtime' group via polkit; non-fatal if it fails
  # so Studio One still launches on systems without the boost unit.
  if systemctl start cpu-governor-boost.service 2>/dev/null; then
    governor_boost_started=1
  fi
}

governor_boost_stop() {
  # Restore the previous (idle) governor once Studio One exits. Registered on
  # EXIT so it also runs when the launcher is interrupted by a signal.
  if [ "$governor_boost_started" -eq 1 ]; then
    systemctl stop cpu-governor-boost.service 2>/dev/null || true
    governor_boost_started=0
  fi
}

smt_boost_start() {
  # Disable SMT (hyper-threading) while Studio One runs; rtcqs warns that
  # enabled SMT can spike DSP load under heavy load. Authorized for the
  # 'realtime' group via polkit; non-fatal if it fails so Studio One still
  # launches without the unit.
  if systemctl start smt-control.service 2>/dev/null; then
    smt_boost_started=1
  fi
}

smt_boost_stop() {
  # Re-enable SMT once Studio One exits. Registered on EXIT so it also runs when
  # the launcher is interrupted by a signal.
  if [ "$smt_boost_started" -eq 1 ]; then
    systemctl stop smt-control.service 2>/dev/null || true
    smt_boost_started=0
  fi
}

studio_boost_start() {
  platform_profile_boost_start
  governor_boost_start
  smt_boost_start
}

studio_boost_stop() {
  smt_boost_stop
  governor_boost_stop
  platform_profile_boost_stop
}

audio_latency_buffer={{ audio_latency_buffer_size }}
audio_latency_rate={{ audio_latency_sample_rate }}
audio_latency_defaults_file="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/audio-latency.defaults.env"
audio_latency_state_file="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/audio-latency.env"

load_audio_latency_file() {
  local file=$1 name value
  if [ ! -r "$file" ]; then
    return
  fi

  while IFS='=' read -r name value; do
    case "$name" in
      AUDIO_LATENCY_DEFAULT_BUFFER|AUDIO_LATENCY_BUFFER)
        [[ "$value" =~ ^[0-9]+$ ]] && audio_latency_buffer="$value"
        ;;
      AUDIO_LATENCY_DEFAULT_RATE|AUDIO_LATENCY_RATE)
        [[ "$value" =~ ^[0-9]+$ ]] && audio_latency_rate="$value"
        ;;
    esac
  done <"$file"
}

export_audio_latency_env() {
  load_audio_latency_file "$audio_latency_defaults_file"
  load_audio_latency_file "$audio_latency_state_file"
  export PIPEWIRE_LATENCY="${audio_latency_buffer}/${audio_latency_rate}"
  export PIPEWIRE_QUANTUM="${audio_latency_buffer}/${audio_latency_rate}"
  export PIPEWIRE_RATE="1/${audio_latency_rate}"
}

SOCK_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SOCK="$SOCK_DIR/studioone-wayland"
WLOG="${TMPDIR:-/tmp}/weston-studio-one.log"
WCONF="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/weston-studio-one.ini"

# Use the default desktop-shell rather than kiosk-shell: Studio One shows modal
# dialogs (project migration, missing plugin, etc.) that kiosk-shell cannot map,
# which leaves the app stuck behind an invisible dialog. The panel is disabled
# via WCONF (panel-position=none). Render with GL (hardware) for low latency; if
# black boxes trail the cursor again, try --renderer=vulkan (or pixman).

export_audio_latency_env

# Load Windows plugins (Vienna Ensemble Pro, etc.) from the REAPER Wine prefix
# where they are installed and configured, matching the native REAPER launcher so
# bridged plugins share their install and settings across DAWs.
export WINEPREFIX={{ arch_reaper_wine_prefix }}
export WINEDEBUG=-all,+err

# Boost the laptop platform profile and CPU governor for the lifetime of this
# Studio One session and restore them on exit (including signals) via the EXIT
# trap, mirroring the REAPER/Ardour launchers.
trap studio_boost_stop EXIT
studio_boost_start

started_weston=0
if [ ! -S "$SOCK" ]; then
    mkdir -p "$SOCK_DIR"
    weston --backend=x11 --renderer=gl --socket=studioone-wayland --config="$WCONF" \
        --width=1920 --height=1080 \
        >"$WLOG" 2>&1 &
    weston_pid=$!
    started_weston=1
    i=0
    while [ ! -S "$SOCK" ]; do
        if ! kill -0 "$weston_pid" 2>/dev/null; then
            echo "weston exited before Studio One started; see $WLOG" >&2
            exit 1
        fi
        i=$((i + 1))
        if [ "$i" -ge 100 ]; then
            echo "weston took too long to start; see $WLOG" >&2
            kill "$weston_pid" 2>/dev/null || true
            exit 1
        fi
        sleep 0.1
    done
fi

# Run (not exec) so the EXIT trap restores the boosted settings after Studio One
# exits.
set +e
WAYLAND_DISPLAY=studioone-wayland "$BIN" "$@"
rc=$?
set -e

if [ "$started_weston" -eq 1 ]; then
    kill "$weston_pid" 2>/dev/null || true
    wait "$weston_pid" 2>/dev/null || true
    rm -f "$SOCK"
fi

exit "$rc"
