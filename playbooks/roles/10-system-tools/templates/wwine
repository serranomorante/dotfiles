#!/usr/bin/env bash
#
# {{ ansible_managed }}
#
# Wrapper installed as ~/bin/wwine for running Wine tools against managed
# prefixes with a default pinned Wine build and optional per-prefix Wine
# profiles.
#
# The Ansible role renders Wine executable/library environments, prefix aliases,
# and optional sandbox profiles into this template. Callers can use stable names
# such as `--prefix reaper` instead of repeating full WINEPREFIX paths and Wine
# build variables. The same template is also installed as
# `wwine-wine-loader`, a WINELOADER-compatible entrypoint for tools such as
# yabridge that can only execute a single Wine loader path without arguments.
#
# Normal Wine launches do not change Wine's virtual desktop registry settings.
# Use the standalone `force-desktop` action when a prefix should be forced into
# Wine virtual desktop mode. Keep the desktop name as `Default`: Ansible wait
# loops match Wine virtual desktop windows through `wmctrl -lx` and
# `explorer.exe`, while the DWM Wine rule also expects Wine's virtual desktop
# window title.
#
# Desktop launchers can pass `--log-id <app-id>` to rotate and capture stdout
# and stderr under ~/.local/state/wine-apps without opening a terminal window.
# Add `--inspect-network` to sandboxed launches to open a Kitty window running
# tcpdump in the Firejail network namespace.

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: wwine --prefix <alias-or-path> [--arch <arch>] [--wine-profile <profile>] [--use-sandbox] [--sandbox-profile <path>] [--sandbox-check-profile <path>] [--sandbox-name <name>] [--inspect-network] [--network-inspector-command <command>] [--log-id <app-id>] [--wine-debug <spec>] <tool> [tool-args...]

tools: wine, winecfg, wineserver, winetricks, wineboot, prepare-env, kill-prefix, kill-server, force-desktop [WxH]
EOF
}

die() {
  printf 'wwine: %s\n' "$1" >&2
  exit 1
}

shell_export() {
  local name="$1"
  local value="$2"

  printf 'export %s=%q\n' "$name" "$value"
}

bool_arg() {
  case "$1" in
    1|true|yes|on)
      printf '1\n'
      ;;
    *)
      printf '0\n'
      ;;
  esac
}

is_inside_firejail() {
  [[ -d /run/firejail/profile ]] && ! ls /run/firejail/profile >/dev/null 2>&1
}

sandbox_is_registered() {
  [[ -n "$sandbox_name" ]] || return 1

  firejail --list 2>/dev/null | awk -F: -v name="$sandbox_name" '$3 == name { found = 1 } END { exit found ? 0 : 1 }'
}

network_inspector_is_running() {
  local marker="wwine-network-inspector:${sandbox_name}"

  pgrep -af "$marker" >/dev/null 2>&1
}

launch_network_inspector() {
  local app_state_dir
  local inspector_log
  local kitty_bin
  local -a launcher=()
  local title
  local marker

  marker="wwine-network-inspector:${sandbox_name}"

  [[ "$inspect_network" == 1 ]] || return 0
  [[ -n "$sandbox_name" ]] || die "--inspect-network needs --sandbox-name because Firejail can only join a named sandbox"
  app_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/wine-apps/${log_id:-wwine}"
  inspector_log="$app_state_dir/network-inspector.log"

  mkdir -p "$app_state_dir"

  if network_inspector_is_running; then
    printf 'wwine: inspector already running: %s\n' "$sandbox_name" >>"$inspector_log"
    return 0
  fi

  if ! kitty_bin="$(command -v kitty 2>/dev/null)"; then
    printf 'wwine: inspector skipped: kitty missing\n' >>"$inspector_log"
    return 0
  fi
  if ! command -v firejail >/dev/null 2>&1; then
    printf 'wwine: inspector skipped: firejail missing\n' >>"$inspector_log"
    return 0
  fi
  if ! command -v sudo >/dev/null 2>&1; then
    printf 'wwine: inspector skipped: sudo missing\n' >>"$inspector_log"
    return 0
  fi

  title="wwine network: ${log_id:-${prefix_alias:-$prefix}}"
  printf 'wwine: inspector launch: %s %s\n' "$sandbox_name" "$kitty_bin" >>"$inspector_log"

  if command -v setsid >/dev/null 2>&1; then
    launcher=(setsid -f)
  fi

  "${launcher[@]}" "$kitty_bin" --hold --title "$title" --app-id=wwine-network-inspector \
    bash -lc 'printf "Joining Firejail network sandbox: %s\nCommand: %s\n\n" "$2" "$3"; exec sudo firejail --join-network="$2" bash -lc '\''printf "Joined Firejail network sandbox: %s\n\n" "$1"; eval "$2"; status=$?; printf "\nInspector command exited with status %s. Leaving shell open.\n" "$status"; exec bash -l'\'' wwine-network-inspector-joined "$2" "$3"' \
    wwine-network-inspector "$marker" "$sandbox_name" "$network_inspector_command" >>"$inspector_log" 2>&1 </dev/null & disown || {
      printf 'wwine: inspector launch failed: %s\n' "$sandbox_name" >>"$inspector_log"
      return 0
    }
}

exec_named_firejail() {
  local -a firejail_command=("$@")
  local lock_dir="${XDG_RUNTIME_DIR:-/tmp}/wwine"
  local lock_key="${sandbox_name//[^A-Za-z0-9_.-]/_}"
  local sandbox_lock_fd
  local firejail_pid
  local status

  command -v flock >/dev/null 2>&1 || die "cannot serialize Firejail sandbox startup because flock is missing"

  mkdir -p "$lock_dir"
  exec {sandbox_lock_fd}>"$lock_dir/${lock_key}.lock"
  flock "$sandbox_lock_fd"

  "${firejail_command[@]}" &
  firejail_pid=$!

  while kill -0 "$firejail_pid" 2>/dev/null; do
    if sandbox_is_registered; then
      launch_network_inspector
      break
    fi
    sleep 0.05
  done

  flock -u "$sandbox_lock_fd" || true
  exec {sandbox_lock_fd}>&-

  set +e
  wait "$firejail_pid"
  status=$?
  set -e
  exit "$status"
}

script_name="${0##*/}"
loader_mode=0
if [[ "$script_name" == "wwine-wine-loader" ]]; then
  loader_mode=1
fi

prefix=""
arch=""
wine_profile=""
use_sandbox=0
sandbox_profile=""
sandbox_check_profile=""
sandbox_name=""
inspect_network=0
network_inspector_command="${WWINE_NETWORK_INSPECTOR_COMMAND:-tcpdump -i any -nn -vv}"
log_id=""
wine_debug="${WWINE_WINEDEBUG:-${WINEDEBUG:-}}"
sandbox_attempted="$(bool_arg "${WWINE_SANDBOX_ATTEMPTED:-0}")"
desktop_name="Default"
desktop_size=""
fallback_desktop_size="1920x1080"

if [[ "$loader_mode" == 1 ]]; then
  prefix="${WWINE_PREFIX_ALIAS:-}"
  arch="${WINEARCH:-}"
  wine_profile="${WWINE_WINE_PROFILE:-}"
  use_sandbox="$(bool_arg "${WWINE_USE_SANDBOX:-0}")"
  sandbox_profile="${WWINE_SANDBOX_PROFILE:-}"
  sandbox_check_profile="${WWINE_SANDBOX_CHECK_PROFILE:-}"
  sandbox_name="${WWINE_SANDBOX_NAME:-}"
  inspect_network="$(bool_arg "${WWINE_INSPECT_NETWORK:-0}")"
  network_inspector_command="${WWINE_NETWORK_INSPECTOR_COMMAND:-tcpdump -i any -nn -vv}"
  wine_debug="${WWINE_WINEDEBUG:-${WINEDEBUG:-}}"
  tool="wine"
else
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --prefix)
        shift
        [[ $# -gt 0 ]] || die "missing value for --prefix"
        prefix="$1"
        ;;
      --prefix=*)
        prefix="${1#*=}"
        ;;
      --arch)
        shift
        [[ $# -gt 0 ]] || die "missing value for --arch"
        arch="$1"
        ;;
      --arch=*)
        arch="${1#*=}"
        ;;
      --wine-profile)
        shift
        [[ $# -gt 0 ]] || die "missing value for --wine-profile"
        wine_profile="$1"
        ;;
      --wine-profile=*)
        wine_profile="${1#*=}"
        ;;
      --use-sandbox)
        use_sandbox=1
        ;;
      --no-sandbox)
        use_sandbox=0
        sandbox_profile=""
        ;;
      --sandbox-profile)
        shift
        [[ $# -gt 0 ]] || die "missing value for --sandbox-profile"
        sandbox_profile="$1"
        use_sandbox=1
        ;;
      --sandbox-profile=*)
        sandbox_profile="${1#*=}"
        use_sandbox=1
        ;;
      --sandbox-check-profile)
        shift
        [[ $# -gt 0 ]] || die "missing value for --sandbox-check-profile"
        sandbox_check_profile="$1"
        ;;
      --sandbox-check-profile=*)
        sandbox_check_profile="${1#*=}"
        ;;
      --sandbox-name)
        shift
        [[ $# -gt 0 ]] || die "missing value for --sandbox-name"
        sandbox_name="$1"
        ;;
      --sandbox-name=*)
        sandbox_name="${1#*=}"
        ;;
      --inspect-network)
        inspect_network=1
        use_sandbox=1
        ;;
      --no-inspect-network)
        inspect_network=0
        ;;
      --network-inspector-command)
        shift
        [[ $# -gt 0 ]] || die "missing value for --network-inspector-command"
        network_inspector_command="$1"
        inspect_network=1
        use_sandbox=1
        ;;
      --network-inspector-command=*)
        network_inspector_command="${1#*=}"
        inspect_network=1
        use_sandbox=1
        ;;
      --log-id)
        shift
        [[ $# -gt 0 ]] || die "missing value for --log-id"
        log_id="$1"
        ;;
      --log-id=*)
        log_id="${1#*=}"
        ;;
      --wine-debug)
        shift
        [[ $# -gt 0 ]] || die "missing value for --wine-debug"
        wine_debug="$1"
        ;;
      --wine-debug=*)
        wine_debug="${1#*=}"
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --)
        shift
        break
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        break
        ;;
    esac
    shift
  done

  [[ $# -gt 0 ]] || {
    usage
    die "missing tool"
  }

  tool="$1"
  shift
fi

if [[ -z "$prefix" && -n "${WINEPREFIX:-}" ]]; then
  case "$WINEPREFIX" in
{% for name, config in wwine_prefix_aliases.items() %}
    "{{ config.path }}")
      prefix="{{ name }}"
      ;;
{% endfor %}
  esac
fi

if [[ -z "$prefix" && -n "${WINEPREFIX:-}" ]]; then
  prefix="$WINEPREFIX"
fi

[[ -n "$prefix" ]] || {
  usage
  die "--prefix is required"
}

resolved_prefix=""
prefix_alias=""

case "$prefix" in
{% for name, config in wwine_prefix_aliases.items() %}
  {{ name }}|"{{ config.path }}")
    prefix_alias="{{ name }}"
    resolved_prefix="{{ config.path }}"
    {% if config.architecture is defined %}
    [[ -n "$arch" ]] || arch="{{ config.architecture }}"
    {% endif %}
    {% if config.wine_profile is defined %}
    [[ -n "$wine_profile" ]] || wine_profile="{{ config.wine_profile }}"
    {% endif %}
    {% if config.sandbox_profile is defined %}
    [[ -n "$sandbox_profile" ]] || sandbox_profile="{{ config.sandbox_profile }}"
    {% endif %}
    {% if config.sandbox_check_profile is defined %}
    [[ -n "$sandbox_check_profile" ]] || sandbox_check_profile="{{ config.sandbox_check_profile }}"
    {% endif %}
    {% if config.sandbox_name is defined %}
    [[ -n "$sandbox_name" ]] || sandbox_name="{{ config.sandbox_name }}"
    {% endif %}
    ;;
{% endfor %}
  *)
    resolved_prefix="$prefix"
    ;;
esac

[[ -n "$wine_profile" ]] || wine_profile="legacy"

{% set wwine_wine_env_profiles = wine_env_profiles | default({'legacy': wine_env_vars}) %}
case "$wine_profile" in
{% for name, env_vars in wwine_wine_env_profiles.items() %}
  "{{ name }}")
    wine_env_WINEVERPATH="{{ env_vars.WINEVERPATH }}"
    wine_env_WINELOADER="{{ env_vars.WINELOADER }}"
    wine_env_WINESERVER="{{ env_vars.WINESERVER }}"
    wine_env_WINEDLLPATH="{{ env_vars.WINEDLLPATH }}"
    wine_env_LD_LIBRARY_PATH="{{ env_vars.LD_LIBRARY_PATH }}"
    wine_env_PATH="{{ env_vars.PATH }}"
    wine_env_WINEFSYNC="{{ env_vars.WINEFSYNC | default('') }}"
    ;;
{% endfor %}
  *)
    die "unknown Wine profile: $wine_profile"
    ;;
esac

real_wine_loader="$wine_env_WINELOADER"
wwine_loader="{{ ansible_facts.env.HOME }}/bin/wwine-wine-loader"
profile_checker="{{ ansible_facts.env.HOME }}/bin/fj-profile-checker"

export WINEVERPATH="$wine_env_WINEVERPATH"
export WINELOADER="$real_wine_loader"
export WINESERVER="$wine_env_WINESERVER"
export WINEDLLPATH="$wine_env_WINEDLLPATH"
export LD_LIBRARY_PATH="$wine_env_LD_LIBRARY_PATH"
export PATH="$wine_env_PATH"
if [[ -n "$wine_env_WINEFSYNC" ]]; then
  export WINEFSYNC="$wine_env_WINEFSYNC"
else
  unset WINEFSYNC
fi
export WINEPREFIX="$resolved_prefix"

if [[ -n "$wine_debug" ]]; then
  export WINEDEBUG="$wine_debug"
fi

if [[ -n "$arch" ]]; then
  export WINEARCH="$arch"
fi

if [[ "$use_sandbox" == 1 && -z "$sandbox_profile" ]]; then
  die "--use-sandbox needs a sandbox_profile for this prefix or --sandbox-profile"
fi

if [[ "$inspect_network" == 1 && -z "$sandbox_name" ]]; then
  die "--inspect-network needs --sandbox-name because Firejail can only join a named sandbox"
fi

if [[ -z "$sandbox_check_profile" ]]; then
  sandbox_check_profile="$sandbox_profile"
fi

verify_inherited_sandbox() {
  if [[ ! -x "$profile_checker" ]]; then
    die "cannot verify inherited Firejail sandbox because fj-profile-checker is missing: $profile_checker"
  fi

  "$profile_checker" "$sandbox_check_profile" -- true
}

validate_log_id() {
  [[ -n "$log_id" ]] || return 0

  if [[ ! "$log_id" =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]]; then
    die "--log-id must be lowercase kebab-case starting with a letter: $log_id"
  fi
}

setup_launcher_log() {
  local state_root
  local app_state_dir
  local log_file
  local config_home
  local logrotate_config
  local logrotate_state

  [[ -n "$log_id" ]] || return 0
  [[ "$tool" != "prepare-env" ]] || return 0
  validate_log_id

  if [[ "${WWINE_LOG_ACTIVE:-0}" == 1 ]]; then
    return 0
  fi

  state_root="${XDG_STATE_HOME:-$HOME/.local/state}/wine-apps"
  app_state_dir="$state_root/$log_id"
  log_file="$app_state_dir/$log_id.log"
  config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  logrotate_config="$config_home/logrotate/wine-apps.conf"
  logrotate_state="$state_root/logrotate.status"

  mkdir -p "$app_state_dir"

  if [[ ! -r "$logrotate_config" ]]; then
    die "--log-id needs readable logrotate config: $logrotate_config"
  fi

  if ! command -v logrotate >/dev/null 2>&1; then
    die "--log-id needs logrotate in PATH"
  fi

  logrotate -s "$logrotate_state" "$logrotate_config"

  export WWINE_LOG_ACTIVE=1
  exec >>"$log_file" 2>&1
  printf '== wwine %s log-id=%s tool=%s ==\n' "$(date -Is)" "$log_id" "$tool"
}

setup_launcher_log

if [[ "$use_sandbox" == 1 && "$tool" != "prepare-env" && "$tool" != "kill-server" ]]; then
  if is_inside_firejail; then
    verify_inherited_sandbox
    launch_network_inspector
  else
    if [[ "$sandbox_attempted" == 1 ]]; then
      die "Firejail re-executed wwine without entering the expected sandbox"
    fi

    if [[ ! -x "$profile_checker" ]]; then
      die "cannot start a verifiable Firejail sandbox because fj-profile-checker is missing: $profile_checker"
    fi

    export WWINE_SANDBOX_ATTEMPTED=1

    if [[ "$loader_mode" == 1 ]]; then
      if [[ -n "$sandbox_name" ]]; then
        exec_named_firejail firejail --profile="$sandbox_profile" --join-or-start="$sandbox_name" "$0" "$@"
      fi

      exec firejail --profile="$sandbox_profile" "$0" "$@"
    fi

    reexec_args=(--prefix "$prefix" --use-sandbox)
    if [[ -n "$sandbox_profile" ]]; then
      reexec_args+=(--sandbox-profile "$sandbox_profile")
    fi
    if [[ -n "$sandbox_check_profile" ]]; then
      reexec_args+=(--sandbox-check-profile "$sandbox_check_profile")
    fi
    if [[ -n "$arch" ]]; then
      reexec_args+=(--arch "$arch")
    fi
    reexec_args+=(--wine-profile "$wine_profile")
    if [[ -n "$sandbox_name" ]]; then
      reexec_args+=(--sandbox-name "$sandbox_name")
    fi
    if [[ "$inspect_network" == 1 ]]; then
      reexec_args+=(--inspect-network --network-inspector-command "$network_inspector_command")
    fi
    if [[ -n "$log_id" ]]; then
      reexec_args+=(--log-id "$log_id")
    fi
    if [[ -n "$wine_debug" ]]; then
      reexec_args+=(--wine-debug "$wine_debug")
    fi

    if [[ -n "$sandbox_name" ]]; then
      exec_named_firejail firejail --profile="$sandbox_profile" --join-or-start="$sandbox_name" "$0" "${reexec_args[@]}" "$tool" "$@"
    fi

    exec firejail --profile="$sandbox_profile" "$0" "${reexec_args[@]}" "$tool" "$@"
  fi
fi

run_wine_loader() {
  "$WINELOADER" "$@"
}

exec_wine_loader() {
  exec "$WINELOADER" "$@"
}

exec_program() {
  exec "$@"
}

configure_desktop() {
  if [[ -z "$desktop_size" ]]; then
    desktop_size="$(default_desktop_size)"
  fi

  [[ "$desktop_size" =~ ^[0-9]+x[0-9]+$ ]] || die "force-desktop size must be WxH, got: $desktop_size"

  run_wine_loader reg add 'HKEY_CURRENT_USER\Software\Wine\Explorer' /v Desktop /d "$desktop_name" /f >/dev/null
  run_wine_loader reg add 'HKEY_CURRENT_USER\Software\Wine\Explorer\Desktops' /v "$desktop_name" /d "$desktop_size" /f >/dev/null
}

default_desktop_size() {
  local helper

  if command -v x11-monitor-geometry >/dev/null 2>&1; then
    helper="$(command -v x11-monitor-geometry)"
  elif [[ -x "$HOME/dotfiles/utilities/bin/x11-monitor-geometry" ]]; then
    helper="$HOME/dotfiles/utilities/bin/x11-monitor-geometry"
  else
    printf '%s\n' "$fallback_desktop_size"
    return
  fi

  "$helper" --monitor current --format size 2>/dev/null || printf '%s\n' "$fallback_desktop_size"
}

print_environment() {
  local exported_wine_loader="$real_wine_loader"

  if [[ "$use_sandbox" == 1 ]]; then
    exported_wine_loader="$wwine_loader"
  fi

  shell_export WINEVERPATH "$WINEVERPATH"
  shell_export WINELOADER "$exported_wine_loader"
  shell_export WINESERVER "$WINESERVER"
  shell_export WINEDLLPATH "$WINEDLLPATH"
  shell_export LD_LIBRARY_PATH "$LD_LIBRARY_PATH"
  shell_export PATH "$PATH"
  if [[ -n "${WINEFSYNC:-}" ]]; then
    shell_export WINEFSYNC "$WINEFSYNC"
  else
    printf 'unset WINEFSYNC\n'
  fi
  shell_export WINEPREFIX "$WINEPREFIX"
  shell_export WWINE_PREFIX_ALIAS "$prefix_alias"
  shell_export WWINE_WINE_PROFILE "$wine_profile"
  shell_export WWINE_USE_SANDBOX "$use_sandbox"
  shell_export WWINE_SANDBOX_PROFILE "$sandbox_profile"
  shell_export WWINE_SANDBOX_CHECK_PROFILE "$sandbox_check_profile"
  shell_export WWINE_SANDBOX_NAME "$sandbox_name"
  shell_export WWINE_INSPECT_NETWORK "$inspect_network"
  shell_export WWINE_NETWORK_INSPECTOR_COMMAND "$network_inspector_command"
  shell_export WWINE_WINEDEBUG "$wine_debug"

  if [[ -n "${WINEARCH:-}" ]]; then
    shell_export WINEARCH "$WINEARCH"
  fi
  if [[ -n "${WINEDEBUG:-}" ]]; then
    shell_export WINEDEBUG "$WINEDEBUG"
  fi
}

{% raw %}
process_has_prefix() {
  local pid="$1"
  local environ="/proc/$pid/environ"
  local process_prefix

  [[ -r "$environ" ]] || return 1

  process_prefix="$(cat "$environ" 2>/dev/null | tr '\0' '\n' | sed -n 's/^WINEPREFIX=//p' | head -n 1)" || return 1
  [[ "$process_prefix" == "$WINEPREFIX" ]]
}

process_looks_like_wine() {
  local pid="$1"
  local comm=""
  local exe=""
  local cmdline=""

  [[ -r "/proc/$pid/comm" ]] && comm="$(<"/proc/$pid/comm")"
  exe="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
  if [[ -r "/proc/$pid/cmdline" ]]; then
    cmdline="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
  fi

  case "$comm $exe $cmdline" in
    *wine*|*Wine*|*wineserver*|*winedevice*|*explorer.exe*)
      return 0
      ;;
  esac

  if [[ -r "/proc/$pid/maps" ]] && grep -Eq '(/wine/|/wine-|libwine|ntdll\.so|kernel32\.dll)' "/proc/$pid/maps" 2>/dev/null; then
    return 0
  fi

  return 1
}

prefix_wine_pids() {
  local environ
  local pid

  for environ in /proc/[0-9]*/environ; do
    [[ -e "$environ" ]] || continue
    pid="${environ%/environ}"
    pid="${pid##*/}"
    [[ "$pid" != "$$" ]] || continue
    [[ "$pid" != "${BASHPID:-}" ]] || continue

    if process_has_prefix "$pid" && process_looks_like_wine "$pid"; then
      printf '%s\n' "$pid"
    fi
  done
}

wait_for_prefix_wine_exit() {
  local deadline="$1"
  local -a pids=()

  while (( SECONDS < deadline )); do
    mapfile -t pids < <(prefix_wine_pids)
    [[ "${#pids[@]}" -eq 0 ]] && return 0
    sleep 0.2
  done

  return 1
}

kill_prefix() {
  local -a pids=()
  local deadline

  "$WINESERVER" -k >/dev/null 2>&1 || true

  deadline=$((SECONDS + 5))
  wait_for_prefix_wine_exit "$deadline" && return 0

  mapfile -t pids < <(prefix_wine_pids)
  if [[ "${#pids[@]}" -gt 0 ]]; then
    kill -TERM "${pids[@]}" 2>/dev/null || true
  fi

  deadline=$((SECONDS + 3))
  wait_for_prefix_wine_exit "$deadline" && return 0

  mapfile -t pids < <(prefix_wine_pids)
  if [[ "${#pids[@]}" -gt 0 ]]; then
    kill -KILL "${pids[@]}" 2>/dev/null || true
  fi
}

kill_server() {
  kill_prefix

  [[ -n "$sandbox_name" ]] || return 0
  command -v firejail >/dev/null 2>&1 || return 0

  firejail --shutdown="$sandbox_name" >/dev/null 2>&1 || true
}
{% endraw %}

case "$tool" in
  wine)
    exec_wine_loader "$@"
    ;;
  winecfg)
    exec_program "$WINEVERPATH/bin/winecfg" "$@"
    ;;
  wineserver)
    exec_program "$WINESERVER" "$@"
    ;;
  wineboot)
    exec_program "$WINEVERPATH/bin/wineboot" "$@"
    ;;
  winetricks)
    exec_program winetricks "$@"
    ;;
  prepare-env)
    if [[ "$loader_mode" == 1 ]]; then
      die "prepare-env cannot be used from wwine-wine-loader"
    fi
    print_environment
    ;;
  kill-prefix)
    kill_prefix
    ;;
  kill-server)
    kill_server
    ;;
  force-desktop)
    if [[ "$loader_mode" == 1 ]]; then
      die "force-desktop cannot be used from wwine-wine-loader"
    fi
    [[ "$#" -le 1 ]] || die "force-desktop accepts at most one optional WxH size"
    desktop_size="${1:-}"
    configure_desktop
    ;;
  *)
    usage
    die "unsupported tool: $tool"
    ;;
esac
