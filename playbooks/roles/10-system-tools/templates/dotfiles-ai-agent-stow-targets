#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Purpose: Generate a Firejail include that exposes active Stow-managed
# dotfile targets to sandboxed AI agents without exposing all of $HOME.
set -euo pipefail

SCRIPT_NAME=$(basename "$0")

die() {
    printf '%s: %s\n' "$SCRIPT_NAME" "$*" >&2
    exit 1
}

usage() {
    cat <<'USAGE'
Usage:
  dotfiles-ai-agent-stow-targets [--output FILE] [--snapshot-output FILE] [--target DIR] [--dotfiles-dir DIR]
  dotfiles-ai-agent-stow-targets --help

Generate whitelist-ro rules for Stow targets that already exist under the target
directory. The output is safe to include from AI agent Firejail profiles.
USAGE
}

real_home=${HOME:-}
[[ -n "$real_home" ]] || die "HOME is required"

dotfiles_stow_dir={{ (ansible_facts.env.HOME + '/dotfiles') | quote }}
target_dir=$real_home
output_path=${DOTFILES_AI_AGENT_STOW_TARGETS_OUTPUT:-$real_home/.config/firejail/ai-agent-stow-targets.inc}
snapshot_output_path=${DOTFILES_AI_AGENT_STOW_TARGETS_SNAPSHOT_OUTPUT:-$real_home/.local/share/firejail-wrapper/ai-agent-profiles/ai-agent-stow-targets.inc}
stow_bin=${DOTFILES_AI_AGENT_STOW_TARGETS_STOW_BIN:-}

{% set agent_context_ignore_patterns = ([dotfiles_agent_context_source_name] + dotfiles_agent_context_symlink_names + dotfiles_private_agent_context_doc_paths) | map('regex_escape') | list %}
{% set stow_ignore_patterns = dotfiles_stow_ignore_patterns + agent_context_ignore_patterns %}
stow_args=(
{% for option in dotfiles_stow_options %}
    {{ option | quote }}
{% endfor %}
{% for pattern in stow_ignore_patterns %}
    --ignore={{ pattern | quote }}
{% endfor %}
)

packages=(
{% for package in dotfiles_public_stow_packages + dotfiles_private_stow_packages %}
    {{ package | quote }}
{% endfor %}
)

while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    --output)
        [[ $# -ge 2 ]] || die "--output needs a value"
        output_path=$2
        shift 2
        ;;
    --snapshot-output)
        [[ $# -ge 2 ]] || die "--snapshot-output needs a value"
        snapshot_output_path=$2
        shift 2
        ;;
    --target)
        [[ $# -ge 2 ]] || die "--target needs a value"
        target_dir=$2
        shift 2
        ;;
    --dotfiles-dir)
        [[ $# -ge 2 ]] || die "--dotfiles-dir needs a value"
        dotfiles_stow_dir=$2
        shift 2
        ;;
    *)
        die "unknown argument: $1"
        ;;
    esac
done

[[ -d "$dotfiles_stow_dir" ]] || die "missing dotfiles Stow dir: $dotfiles_stow_dir"
[[ -d "$target_dir" ]] || die "missing Stow target dir: $target_dir"

if [[ -z "$stow_bin" ]]; then
    if command -v stow >/dev/null 2>&1; then
        stow_bin=$(command -v stow)
    elif [[ -x "$real_home/.local/bin/stow" ]]; then
        stow_bin=$real_home/.local/bin/stow
    else
        die "stow not found"
    fi
fi

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-ai-agent-stow-targets.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
simulation_target=$tmp_dir/target
simulation_output=$tmp_dir/stow-output
raw_targets=$tmp_dir/raw-targets
filtered_targets=$tmp_dir/filtered-targets
generated_include=$tmp_dir/ai-agent-stow-targets.inc
mkdir -p "$simulation_target"

existing_packages=()
for package in "${packages[@]}"; do
    [[ -d "$dotfiles_stow_dir/$package" ]] || continue
    existing_packages+=("$package")
done

: >"$raw_targets"
if [[ "{% raw %}${#existing_packages[@]}{% endraw %}" -gt 0 ]]; then
    if ! "$stow_bin" --dir="$dotfiles_stow_dir" --target="$simulation_target" --simulate --verbose=2 "${stow_args[@]}" "${existing_packages[@]}" >"$simulation_output" 2>&1; then
        sed -n '1,160p' "$simulation_output" >&2
        die "Stow simulation failed"
    fi

    awk '
        /^LINK: / {
            line = $0
            sub(/^LINK: /, "", line)
            sub(/ => .*$/, "", line)
            print line
        }
    ' "$simulation_output" >"$raw_targets"
fi

: >"$filtered_targets"
while IFS= read -r rel_path; do
    [[ -n "$rel_path" ]] || continue
    rel_path=${rel_path#./}
    case "$rel_path" in
    "" | "." | /* | ../* | */../* | *" "* | *$'\t'*)
        continue
        ;;
    .mypy_cache | .mypy_cache/* | */.mypy_cache | */.mypy_cache/* | __pycache__ | */__pycache__ | __pycache__/* | */__pycache__/* | *.pyc)
        continue
        ;;
    .config/firejail | .config/firejail/*)
        continue
        ;;
    esac

    target_path=$target_dir/$rel_path
    [[ -e "$target_path" || -L "$target_path" ]] || continue
    resolved_target=$(readlink -f "$target_path" 2>/dev/null || true)
    [[ -n "$resolved_target" ]] || continue
    case "$resolved_target" in
    "$dotfiles_stow_dir"/*) ;;
    *) continue ;;
    esac

    printf '%s\n' "$rel_path"
done <"$raw_targets" | sort -u >"$filtered_targets"

{
    printf '%s\n' "# Generated by dotfiles-ai-agent-stow-targets."
    printf '%s\n' "# Exposes active GNU Stow targets as read-only paths for AI agent sandboxes."
    printf '%s\n' "# Regenerate by running dotfiles-stow for the affected package."
    while IFS= read -r rel_path; do
        printf 'whitelist-ro ${HOME}/%s\n' "$rel_path"
    done <"$filtered_targets"
} >"$generated_include"

install_include() {
    local source_file=$1
    local dest_file=$2
    local dest_dir

    [[ -n "$dest_file" ]] || return 0
    dest_dir=$(dirname "$dest_file")
    [[ -d "$dest_dir" ]] || mkdir -p "$dest_dir"

    if [[ -e "$dest_file" ]] && cmp -s "$source_file" "$dest_file"; then
        printf 'unchanged %s\n' "$dest_file"
        return 0
    fi

    cp "$source_file" "$dest_file"
    chmod 644 "$dest_file"
    printf 'updated %s\n' "$dest_file"
}

install_include "$generated_include" "$output_path"
install_include "$generated_include" "$snapshot_output_path"
