    "darkBg": "#0d1117",
    "darkPanel": "#111827",
    "darkElement": "#1f2937",
    "darkElementActive": "#263445",
    "darkText": "#f0f6fc",
    "darkMuted": "#8b949e",
    "darkBlue": "#58a6ff",
    "darkBlueBright": "#79c0ff",
    "darkGreen": "#56d364",
    "darkYellow": "#e3b341",
    "darkOrange": "#f0883e",
