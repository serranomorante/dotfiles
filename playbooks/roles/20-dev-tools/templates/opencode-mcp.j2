#!/bin/sh
# {{ ansible_managed }}
# Purpose: Start OpenCode with MCP tools routed through the local MCPHub proxy profile.
# Usage: opencode-mcp [opencode args...]

set -eu

exec "{{ node_user_bin_dir }}/fj-opencode" --exec -- env OPENCODE_CONFIG="$HOME/.config/opencode/mcphub.json" "{{ node_user_bin_dir }}/opencode" "$@"
