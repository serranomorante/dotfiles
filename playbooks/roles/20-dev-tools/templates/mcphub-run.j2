#!/bin/sh
# {{ ansible_managed }}
# Purpose: Start the local MCPHub HTTP proxy on demand before running an MCP-aware command.
# Usage: mcphub-run codex -p mcphub
# Notes: MCPHub is started with auto-shutdown so its managed MCP children exit after clients disconnect.

set -eu

if [ "$#" -eq 0 ]; then
    printf '%s\n' "usage: mcphub-run <command> [args...]" >&2
    exit 2
fi

port=${MCPHUB_PORT:-{{ mcphub_setup.port }}}
config=${MCPHUB_CONFIG:-"$HOME/.config/mcphub/servers.json"}
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}
log_dir=$state_dir/mcp-hub/logs
health_url=http://127.0.0.1:$port/api/health

hub_ready() {
    curl -fsS --max-time 1 "$health_url" >/dev/null 2>&1
}

if ! hub_ready; then
    mkdir -p "$log_dir"
    nohup "{{ node_user_bin_dir }}/mcp-hub" \
        --port "$port" \
        --config "$config" \
        --watch \
        --auto-shutdown \
        --shutdown-delay "{{ mcphub_setup.shutdown_delay_ms }}" \
        >>"$log_dir/mcphub-run.log" 2>&1 &

    i=0
    while [ "$i" -lt 80 ]; do
        if hub_ready; then
            break
        fi
        i=$((i + 1))
        sleep 0.25
    done
fi

if ! hub_ready; then
    printf '%s\n' "mcphub-run: MCPHub did not become ready at $health_url" >&2
    exit 1
fi

exec "$@"
