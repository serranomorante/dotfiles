#!/usr/bin/env sh
# Purpose: Open a shared snippet picker and paste the selected text, or paste a
# named snippet directly with dynamic {var:KEY} substitution and {regex:...}
# clipboard substitution.
# Usage: snippets [<name> [var:KEY=VALUE ...]]
# Notes: Snippets are stored as plain files under utilities/dot-local/share/dotfiles/snippets/ and, when present, for-my-eyes-only/dot-local/share/dotfiles/snippets/. Snippet files can add YAML frontmatter with `snippet-title:` and `snippet-summary:` keys; the picker shows those fields but pastes only the body after the closing `---`. The picker wraps long title/summary rows and renders the body in an fzf preview pane on the right (via the internal `preview` action); when `bat` is installed the preview is Markdown-highlighted, otherwise it falls back to plain text. When launched from Kitty, the parent process waits for the quick-access picker to close before copying and pasting, so terminal detection never sees the picker itself. When invoked with a snippet name, it resolves that snippet by basename across the public and private roots, strips the metadata, replaces any `{var:KEY}` placeholders with the provided `var:KEY=VALUE` pairs, and pastes the result directly without opening the picker. Snippet bodies can also embed `{regex:s/pat/rep/flags}` placeholders (optionally with a different delimiter such as `s|...|...|`); those expand to the current clipboard text run through that sed-style substitution, with each clipboard line processed independently like `sed s///`, `\1`..`\9` backreferences rewritten to `$1`..`$9`, and Perl escapes/flags (`gimsx`) available. The fzf preview and the paste handoff both resolve `{regex:...}` against the live clipboard; if the clipboard is unreadable a paste aborts before anything is copied or pasted, and the preview then shows the raw body.

set -eu

prog=${0##*/}
script_path=$0
if [ -n "${DOTFILES_SNIPPETS_DIR:-}" ]; then
    snippet_dir_explicit=1
else
    snippet_dir_explicit=0
fi
snippet_dir=${DOTFILES_SNIPPETS_DIR:-"$HOME/dotfiles/utilities/dot-local/share/dotfiles/snippets"}
snippet_context=${DOTFILES_SNIPPETS_CONTEXT:-terminal}
snippet_app_id=${DOTFILES_SNIPPETS_APP_ID:-kitty-snippets}
snippet_instance_group_prefix=${DOTFILES_SNIPPETS_INSTANCE_GROUP_PREFIX:-kitty-snippets}
snippet_payload_out=${DOTFILES_SNIPPETS_PAYLOAD_OUT:-}
snippet_paste_wait_attempts=${DOTFILES_SNIPPETS_PASTE_WAIT_ATTEMPTS:-40}
snippet_paste_wait_interval=${DOTFILES_SNIPPETS_PASTE_WAIT_INTERVAL:-0.05}
snippet_paste_settle_delay=${DOTFILES_SNIPPETS_PASTE_SETTLE_DELAY:-0.12}
# Windows apps under Wine (REAPER plugin controls) stop routing keyboard input
# to the focused control once another window has taken focus; a real click is
# needed to restore it. When the target window class is in
# DOTFILES_SNIPPETS_REFOCUS_CLICK_CLASSES, replay the pointer click that was
# active when the picker was summoned before sending the paste keystroke.
snippet_refocus_click=${DOTFILES_SNIPPETS_REFOCUS_CLICK:-1}
snippet_refocus_click_classes=${DOTFILES_SNIPPETS_REFOCUS_CLICK_CLASSES:-reaper}
# Wine needs a beat after the replayed click to hand keyboard focus to the
# control before the paste keystroke will land. Tune with
# DOTFILES_SNIPPETS_REFOCUS_CLICK_DELAY if a target is slower.
snippet_refocus_click_delay=${DOTFILES_SNIPPETS_REFOCUS_CLICK_DELAY:-0.5}
snippet_debug=${DOTFILES_SNIPPETS_DEBUG:-0}
snippet_debug_log=${DOTFILES_SNIPPETS_DEBUG_LOG:-"${XDG_STATE_HOME:-$HOME/.local/state}/snippets/debug.log"}
# A body copied straight from the snippet file ends with a newline, which some
# targets paste as stray junk (for example Wine/REAPER edit fields). Strip
# trailing blank lines and the final newline before the clipboard copy.
snippet_trim_trailing_newline=${DOTFILES_SNIPPETS_TRIM_TRAILING_NEWLINE:-1}

debug_log() {
    [ "${snippet_debug:-0}" = 1 ] || return 0
    [ -n "$snippet_debug_log" ] || return 0
    mkdir -p "$(dirname "$snippet_debug_log")" 2>/dev/null || return 0
    printf '%s: %s\n' "$(date +%s)" "$*" >>"$snippet_debug_log"
}
terminal_classes='kitty alacritty foot wezterm xterm urxvt konsole st ghostty kitty-lazygit kitty-nnn kitty-dmenu'

die() {
    printf '%s: %s\n' "$prog" "$*" >&2
    exit 2
}

usage() {
    cat <<EOF
Usage:
  $prog
  $prog <name> [var:KEY=VALUE ...]

Open the shared snippet picker and paste the selected text into the previously focused window.
With a <name>, paste that snippet directly without the picker, resolving it by
basename and substituting {var:KEY} placeholders with the given values and
{regex:s/pat/rep/flags} placeholders with the current clipboard text run
through that substitution.
EOF
}

need_command() {
    command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

resolve_script_path() {
    case $script_path in
    /*) ;;
    *)
        resolved_script_path=$(command -v "$script_path" 2>/dev/null || true)
        if [ -n "$resolved_script_path" ]; then
            script_path=$resolved_script_path
        fi
        ;;
    esac
}

ensure_snippet_dir() {
    [ -d "$snippet_dir" ] || die "missing snippet directory: $snippet_dir"
}

snippets_panel_group() {
    printf '%s-%s\n' "$snippet_instance_group_prefix" "${KITTY_OS_INSTANCE_ID:-default}"
}

snippet_source_dirs() {
    if [ -n "${DOTFILES_SNIPPETS_DIR:-}" ]; then
        printf '%s\t%s\n' "$snippet_dir" custom
        return 0
    fi

    printf '%s\t%s\n' "$HOME/dotfiles/utilities/dot-local/share/dotfiles/snippets" public

    private_snippet_dir="$HOME/dotfiles/for-my-eyes-only/dot-local/share/dotfiles/snippets"
    [ -d "$private_snippet_dir" ] && printf '%s\t%s\n' "$private_snippet_dir" private
}

snippet_entry() {
    source_label=$1
    snippet_path=$2
    snippet_name=${snippet_path##*/}

    awk -v source_label="$source_label" -v snippet_name="$snippet_name" -v snippet_path="$snippet_path" '
        function clean(value) {
            gsub(/\r/, "", value)
            gsub(/\t/, " ", value)
            sub(/^[[:space:]]+/, "", value)
            sub(/[[:space:]]+$/, "", value)
            return value
        }

        BEGIN {
            title = ""
            summary = ""
            in_frontmatter = 0
            saw_frontmatter = 0
            content_index = 0
        }

        {
            line = $0

            if (NR == 1 && line ~ /^---[[:space:]]*$/) {
                in_frontmatter = 1
                saw_frontmatter = 1
                next
            }

            if (in_frontmatter) {
                if (line ~ /^---[[:space:]]*$/) {
                    in_frontmatter = 0
                    next
                }

                if (line ~ /^snippet-title:[[:space:]]*/) {
                    sub(/^snippet-title:[[:space:]]*/, "", line)
                    title = clean(line)
                } else if (line ~ /^snippet-summary:[[:space:]]*/) {
                    sub(/^snippet-summary:[[:space:]]*/, "", line)
                    summary = clean(line)
                }
                next
            }

            if (saw_frontmatter && line ~ /^[[:space:]]*$/) {
                next
            }

            if (line ~ /^[[:space:]]*$/) {
                next
            }

            content_index += 1
            if (content_index == 1 && title == "") {
                first_content = clean(line)
            } else if (content_index == 2 && summary == "") {
                second_content = clean(line)
            }
        }

        END {
            if (title == "") {
                title = first_content
            }
            if (summary == "") {
                summary = second_content
            }
            if (title == "") {
                title = snippet_name
            }

            printf "%s\t%s\t%s\t%s\t%s\n", source_label, title, summary, snippet_name, snippet_path
        }
    ' "$snippet_path"
}

snippet_entries() {
    tab=$(printf '\t')
    snippet_source_dirs | while IFS="$tab" read -r source_dir source_label; do
        [ -d "$source_dir" ] || continue
        find "$source_dir" -mindepth 1 -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | sort | while IFS= read -r snippet_name; do
            [ -n "$snippet_name" ] || continue
            snippet_entry "$source_label" "$source_dir/$snippet_name"
        done
    done | LC_ALL=C sort -t "$tab" -k2,2f -k1,1 -k4,4
}

strip_snippet_metadata() {
    awk '
        BEGIN {
            in_frontmatter = 0
            saw_frontmatter = 0
            strip_blank_line = 0
        }
        {
            if (NR == 1 && $0 ~ /^---[[:space:]]*$/) {
                in_frontmatter = 1
                saw_frontmatter = 1
                next
            }

            if (in_frontmatter) {
                if ($0 ~ /^---[[:space:]]*$/) {
                    in_frontmatter = 0
                    strip_blank_line = 1
                }
                next
            }

            if (strip_blank_line && $0 ~ /^[[:space:]]*$/) {
                next
            }

            strip_blank_line = 0
            print
        }
    ' "$1"
}

resolve_snippet_path() {
    name=$1
    tab=$(printf '\t')
    snippet_source_dirs | while IFS="$tab" read -r source_dir source_label; do
        [ -d "$source_dir" ] || continue
        candidate="$source_dir/$name"
        [ -f "$candidate" ] && printf '%s\n' "$candidate"
    done
}

apply_snippet_vars() {
    payload_path=$1
    shift
    for arg in "$@"; do
        case $arg in
        var:*)
            spec=${arg#var:}
            key=${spec%%=*}
            value=${spec#*=}
            [ -n "$key" ] || die "invalid variable: $arg"
            case $key in
            CWD)
                value=$(printf '%s' "$value" | sed 's|^/*||')
                ;;
            esac
            escaped=$(printf '%s' "$value" | sed 's/[&|\\]/\\&/g')
            sed "s|{var:${key}}|${escaped}|g" "$payload_path" >"${payload_path}.tmp" || exit 1
            mv "${payload_path}.tmp" "$payload_path"
            ;;
        *)
            die "unexpected argument: $arg"
            ;;
        esac
    done
}

snippet_body_has_regex() {
    grep -q '{regex:' "$1"
}

read_snippet_clipboard() {
    out_path=$1
    if command -v xclip >/dev/null 2>&1 && xclip -selection clipboard -o >"$out_path" 2>/dev/null; then
        return 0
    fi
    rm -f "$out_path"
    return 1
}

# Expand every {regex:s<D>pat<D>rep<D>flags} placeholder in the payload by
# applying that substitution to the current clipboard text. The substitution
# syntax follows sed, so each clipboard line is processed independently (like
# sed s///) and sed-style \1..\9 backreferences are rewritten to $1..$9; the
# pattern/replacement run through perl, so Perl escapes (\d, \s, \x1b, ...)
# and flags (gimsx) work. SNIPPETS_REGEX_MODE=strict (default) aborts the
# whole expansion on the first invalid placeholder so nothing broken is
# pasted; SNIPPETS_REGEX_MODE=preview replaces the failed placeholder with a
# visible [regex error: ...] marker so the picker can still show a preview.
expand_regex_placeholders() {
    payload_path=$1
    clip_path=$2

    perl - "$payload_path" "$clip_path" >"${payload_path}.expanded" <<'PERL' || return 1
use strict;
use warnings;

my ($body_file, $clip_file) = @ARGV;
my $strict = ($ENV{'SNIPPETS_REGEX_MODE'} || 'strict') ne 'preview';

open my $bfh, '<', $body_file or die "cannot read $body_file: $!\n";
local $/;
my $body = <$bfh>;

my $clip = '';
if (defined $clip_file && $clip_file ne '' && -f $clip_file) {
    open my $cfh, '<', $clip_file or die "cannot read clipboard: $!\n";
    $clip = <$cfh>;
}

sub sed_backrefs {
    my ($text) = @_;
    return $text if index($text, '\\') < 0;
    $text =~ s/\\([1-9])/\$$1/g;
    return $text;
}

sub parse_substitution {
    my ($s, $pos) = @_;
    my $len = length $s;
    return if $pos >= $len || substr($s, $pos, 1) ne 's';

    my $nl = index($s, "\n", $pos);
    $nl = $len if $nl < 0;

    my $i = $pos + 1;
    while ($i < $nl && substr($s, $i, 1) =~ /[ \t]/) { $i++; }
    return if $i >= $nl;
    my $d = substr($s, $i, 1);
    $i++;
    return if $d eq "\n" || $d eq "\r";

    my $ok = 0;
    while ($i < $len) {
        my $c = substr($s, $i, 1);
        if ($c eq '\\' && $i + 1 < $len) { $i += 2; next; }
        if ($c eq '\\') { $i++; next; }
        if ($c eq $d) { $ok = 1; $i++; last; }
        return if $c eq "\n";
        $i++;
    }
    return if !$ok;
    my $repl_start = $i;

    $ok = 0;
    while ($i < $len) {
        my $c = substr($s, $i, 1);
        if ($c eq '\\' && $i + 1 < $len) { $i += 2; next; }
        if ($c eq '\\') { $i++; next; }
        if ($c eq $d) { $ok = 1; $i++; last; }
        return if $c eq "\n";
        $i++;
    }
    return if !$ok;
    my $rep_end = $i - 1;

    while ($i < $len) {
        my $c = substr($s, $i, 1);
        if ($c eq '\\' && $i + 1 < $len) { $i += 2; next; }
        if ($c eq '\\') { $i++; next; }
        if ($c eq '}') {
            my $spec = substr($s, $pos, $repl_start - $pos)
                . sed_backrefs(substr($s, $repl_start, $rep_end - $repl_start))
                . substr($s, $rep_end, $i - $rep_end);
            return ($spec, $i + 1);
        }
        if ($c eq "\n") { return; }
        $i++;
    }
    return;
}

sub transform_clipboard {
    my ($spec) = @_;
    my $err = '';
    my @out;
    for my $line (split /\n/, $clip, -1) {
        my $rc = eval {
            local $_ = $line;
            eval $spec;
            die $@ if $@;
            push @out, $_;
            1;
        };
        if (!$rc) {
            $err = $@;
            last;
        }
    }
    if ($err) {
        if ($strict) {
            print STDERR "snippets: {regex:...} failed: $err";
            exit 1;
        }
        return "[{regex:$spec} ERROR: $err]";
    }
    return join "\n", @out;
}

my $out = '';
my $i = 0;
my $prefix = '{regex:';
my $plen = length $prefix;
while ($i <= length $body) {
    my $start = index($body, $prefix, $i);
    if ($start < 0) { $out .= substr($body, $i); last; }
    $out .= substr($body, $i, $start - $i);
    my $after = $start + $plen;
    if ($after < length $body && substr($body, $after, 1) eq 's') {
        my ($spec, $next) = parse_substitution($body, $after);
        if (defined $spec) {
            $out .= transform_clipboard($spec);
            $i = $next;
            next;
        }
    }
    $out .= $prefix;
    $i = $after;
}
print $out;
PERL
    mv "${payload_path}.expanded" "$payload_path"
}

cleanup_snippets_tmpdir() {
    if [ "${snippets_handoff:-0}" -eq 0 ] && [ -n "${snippets_tmpdir:-}" ] && [ -d "$snippets_tmpdir" ]; then
        rm -rf "$snippets_tmpdir"
    fi
}

normalize_window_class() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

active_window_id() {
    xdotool getactivewindow 2>/dev/null
}

window_class() {
    xdotool getwindowclassname "$1" 2>/dev/null
}

is_picker_class() {
    class=$(normalize_window_class "$1")
    picker_class=$(normalize_window_class "$snippet_app_id")
    [ "$class" = "$picker_class" ]
}

# Some windows (Wine/REAPER plugin controls are the known case) only route
# keyboard input to the focused control after a real pointer click: restoring
# the X focus to the window is not enough once the snippet picker has taken
# focus. Record where the pointer was when the picker was summoned so we can
# replay that click (the control the user was about to use) before pasting.
capture_launch_target() {
    snippet_launch_window=
    snippet_launch_x=
    snippet_launch_y=
    [ "${snippet_refocus_click:-1}" = 1 ] || return 0

    window_id=$(active_window_id) || return 0
    [ -n "$window_id" ] || return 0

    loc=$(xdotool getmouselocation --shell 2>/dev/null) || return 0
    px=
    py=
    for line in $loc; do
        case $line in
        X=*) px=${line#X=} ;;
        Y=*) py=${line#Y=} ;;
        esac
    done

    case $px in
    ''|*[!0-9-]*) return 0 ;;
    esac
    case $py in
    ''|*[!0-9-]*) return 0 ;;
    esac

    snippet_launch_window=$window_id
    snippet_launch_x=$px
    snippet_launch_y=$py
    debug_log "capture window=$window_id xy=$px,$py"
}

refocus_click_matches_class() {
    window_id=$1
    class=$(window_class "$window_id") || return 1
    class=$(normalize_window_class "$class")
    [ -n "$class" ] || return 1

    for allowed in $snippet_refocus_click_classes; do
        [ "$allowed" = "*" ] && return 0
        [ "$class" = "$allowed" ] && return 0
    done
    return 1
}

maybe_refocus_click_target() {
    [ "${snippet_refocus_click:-1}" = 1 ] || return 1
    [ -n "${snippet_launch_window:-}" ] || return 1

    target_window_id=$(active_window_id) || return 1
    [ "$target_window_id" = "$snippet_launch_window" ] || {
        debug_log "refocus skipped: active=$target_window_id launch=$snippet_launch_window"
        return 1
    }

    refocus_click_matches_class "$target_window_id" || {
        debug_log "refocus skipped: class not in $snippet_refocus_click_classes"
        return 1
    }

    debug_log "refocus click at $snippet_launch_x,$snippet_launch_y on window=$target_window_id"
    xdotool mousemove --sync "$snippet_launch_x" "$snippet_launch_y" >/dev/null 2>&1 || return 1
    xdotool click --clearmodifiers 1 >/dev/null 2>&1 || return 1
    sleep "$snippet_refocus_click_delay"
    debug_log "refocus click done"
    return 0
}

wait_for_paste_target() {
    attempt=0
    last_window_id=

    while [ "$attempt" -lt "$snippet_paste_wait_attempts" ]; do
        window_id=$(active_window_id) || {
            attempt=$((attempt + 1))
            sleep "$snippet_paste_wait_interval"
            continue
        }
        class=$(window_class "$window_id") || {
            attempt=$((attempt + 1))
            sleep "$snippet_paste_wait_interval"
            continue
        }

        if ! is_picker_class "$class"; then
            if [ "$window_id" = "$last_window_id" ]; then
                sleep "$snippet_paste_settle_delay"
                return 0
            fi
            last_window_id=$window_id
        else
            last_window_id=
        fi

        attempt=$((attempt + 1))
        sleep "$snippet_paste_wait_interval"
    done

    return 1
}

focused_is_terminal() {
    window_id=$(active_window_id) || return 1
    class=$(window_class "$window_id") || return 1
    is_picker_class "$class" && return 1
    class=$(printf '%s' "$class" | tr '[:upper:]' '[:lower:]')
    for terminal_class in $terminal_classes; do
        [ "$class" = "$terminal_class" ] && return 0
    done
    return 1
}

paste_clipboard() {
    wait_for_paste_target || true

    maybe_refocus_click_target || true

    if focused_is_terminal; then
        debug_log "paste ctrl+shift+v"
        xdotool key --clearmodifiers ctrl+shift+v >/dev/null 2>&1
    else
        debug_log "paste ctrl+v"
        xdotool key --clearmodifiers ctrl+v >/dev/null 2>&1
    fi
}

trim_payload_file() {
    payload_path=$1
    tmp=$(mktemp "${TMPDIR:-/tmp}/snippets.trim.XXXXXX") || return 1

    if awk '
        { lines[NR] = $0 }
        END {
            n = NR
            while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--
            for (i = 1; i <= n; i++) {
                printf "%s", lines[i]
                if (i < n) printf "\n"
            }
        }
    ' "$payload_path" >"$tmp"; then
        mv "$tmp" "$payload_path"
        return 0
    fi

    rm -f "$tmp"
    return 1
}

paste_payload() {
    payload_path=$1

    if [ "${snippet_trim_trailing_newline:-1}" = 1 ]; then
        trim_payload_file "$payload_path" || die "cannot trim payload: $payload_path"
    fi

    xclip -selection clipboard <"$payload_path"
    paste_clipboard
}

paste_named_snippet() {
    [ "$#" -ge 1 ] || die "missing snippet name"
    name=$1
    shift

    snippet_path=$(resolve_snippet_path "$name")
    [ -n "$snippet_path" ] || die "missing snippet: $name"
    [ -r "$snippet_path" ] || die "missing snippet: $name"

    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/snippets.XXXXXX") || exit 1
    snippets_tmpdir=$tmpdir
    snippets_handoff=0
    trap cleanup_snippets_tmpdir EXIT INT HUP TERM
    payload_path=$tmpdir/payload
    strip_snippet_metadata "$snippet_path" >"$payload_path" || exit 1

    if [ "$#" -gt 0 ]; then
        apply_snippet_vars "$payload_path" "$@"
    fi

    if snippet_body_has_regex "$payload_path"; then
        clip_tmp=$tmpdir/clipboard
        if ! read_snippet_clipboard "$clip_tmp"; then
            die "snippet $name: clipboard text is required to expand {regex:...} placeholders"
        fi
        SNIPPETS_REGEX_MODE=strict expand_regex_placeholders "$payload_path" "$clip_tmp" \
            || die "snippet $name: could not expand {regex:...} placeholders"
    fi

    if [ "$snippet_context" = panel ]; then
        [ -n "$snippet_payload_out" ] || die "missing panel payload output path"
        cp "$payload_path" "$snippet_payload_out"
        exit 0
    fi

    paste_payload "$payload_path"
    snippets_handoff=1
    rm -rf "$tmpdir"
}

pick_snippet() {
    selected_snippet=
    tab=$(printf '\t')
    selected_snippet=$(snippet_entries | fzf \
        --prompt="Snippet> " \
        --delimiter="$tab" \
        --with-nth=1,2,3 \
        --wrap \
        --gap=1 \
        --preview-window='right:50%:wrap' \
        --preview-label=' snippet ' \
        --preview="DOTFILES_SNIPPETS_ACTION=preview \"$script_path\" {5}") || exit 0
    [ -n "$selected_snippet" ] || exit 0

    IFS="$tab" read -r _snippet_source _snippet_title _snippet_summary _snippet_name snippet_path <<EOF
$selected_snippet
EOF

    [ -r "$snippet_path" ] || die "missing snippet: $selected_snippet"

    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/snippets.XXXXXX") || exit 1
    snippets_tmpdir=$tmpdir
    snippets_handoff=0
    trap cleanup_snippets_tmpdir EXIT INT HUP TERM
    payload_path=$tmpdir/payload
    strip_snippet_metadata "$snippet_path" >"$payload_path" || exit 1

    if snippet_body_has_regex "$payload_path"; then
        clip_tmp=$tmpdir/clipboard
        if ! read_snippet_clipboard "$clip_tmp"; then
            die "snippet $_snippet_name: clipboard text is required to expand {regex:...} placeholders"
        fi
        SNIPPETS_REGEX_MODE=strict expand_regex_placeholders "$payload_path" "$clip_tmp" \
            || die "snippet $_snippet_name: could not expand {regex:...} placeholders"
    fi

    if [ "$snippet_context" = panel ]; then
        [ -n "$snippet_payload_out" ] || die "missing panel payload output path"
        cp "$payload_path" "$snippet_payload_out"
        exit 0
    fi

    paste_payload "$payload_path"
    snippets_handoff=1
    rm -rf "$tmpdir"
}

launch_picker() {
    resolve_script_path
    ensure_snippet_dir

    if command -v kitten >/dev/null 2>&1; then
        tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/snippets.XXXXXX") || exit 1
        snippets_tmpdir=$tmpdir
        snippets_handoff=0
        trap cleanup_snippets_tmpdir EXIT INT HUP TERM
        payload_path=$tmpdir/payload

        if [ "$snippet_dir_explicit" -eq 1 ]; then
            set -- "DOTFILES_SNIPPETS_DIR=$snippet_dir"
        else
            set --
        fi

        kitten quick-access-terminal \
            --instance-group="$(snippets_panel_group)" \
            --detach=no \
            --override app_id="$snippet_app_id" \
            --override edge=none \
            --override background_opacity=0.8 \
            env \
            DOTFILES_SNIPPETS_ACTION=pick \
            DOTFILES_SNIPPETS_APP_ID="$snippet_app_id" \
            DOTFILES_SNIPPETS_CONTEXT=panel \
            DOTFILES_SNIPPETS_INSTANCE_GROUP_PREFIX="$snippet_instance_group_prefix" \
            DOTFILES_SNIPPETS_PAYLOAD_OUT="$payload_path" \
            "$@" \
            "$script_path"
        status=$?

        if [ "$status" -ne 0 ]; then
            exit "$status"
        fi

        [ -s "$payload_path" ] || exit 0
        paste_payload "$payload_path"
        snippets_handoff=1
        rm -rf "$tmpdir"
        exit 0
    fi

    if [ "$snippet_dir_explicit" -eq 1 ]; then
        set -- "DOTFILES_SNIPPETS_DIR=$snippet_dir"
    else
        set --
    fi

    exec env \
        DOTFILES_SNIPPETS_ACTION=pick \
        DOTFILES_SNIPPETS_APP_ID="$snippet_app_id" \
        DOTFILES_SNIPPETS_CONTEXT=terminal \
        DOTFILES_SNIPPETS_INSTANCE_GROUP_PREFIX="$snippet_instance_group_prefix" \
        "$@" \
        "$script_path"
}

case ${DOTFILES_SNIPPETS_ACTION:-launch} in
launch)
    if [ "$#" -gt 0 ]; then
        case $1 in
        -h | --help)
            usage
            exit 0
            ;;
        *)
            need_command xclip
            need_command xdotool
            capture_launch_target
            paste_named_snippet "$@"
            exit 0
            ;;
        esac
    fi
    need_command fzf
    need_command xclip
    need_command xdotool
    capture_launch_target
    launch_picker
    ;;
pick)
    need_command fzf
    need_command xclip
    need_command xdotool
    ensure_snippet_dir
    pick_snippet
    ;;
preview)
    [ "$#" -ge 1 ] || die "missing snippet path for preview"
    [ -r "$1" ] || die "missing snippet: $1"
    body_tmp=$(mktemp "${TMPDIR:-/tmp}/snippets-preview.XXXXXX") || exit 1
    trap 'rm -f "$body_tmp" "$body_tmp.clip"' EXIT HUP INT TERM
    strip_snippet_metadata "$1" >"$body_tmp" || exit 1

    if snippet_body_has_regex "$body_tmp"; then
        if read_snippet_clipboard "$body_tmp.clip"; then
            SNIPPETS_REGEX_MODE=preview expand_regex_placeholders "$body_tmp" "$body_tmp.clip" || true
            rm -f "$body_tmp.clip"
        fi
    fi

    bat_bin=
    if command -v bat >/dev/null 2>&1; then
        bat_bin=bat
    elif command -v batcat >/dev/null 2>&1; then
        bat_bin=batcat
    fi
    if [ -n "$bat_bin" ]; then
        "$bat_bin" \
            --color=always \
            --style=plain \
            --paging=never \
            --language=markdown \
            --terminal-width="${FZF_PREVIEW_COLUMNS:-80}" \
            "$body_tmp"
    else
        cat "$body_tmp"
    fi
    rm -f "$body_tmp"
    ;;
*)
    die "unsupported action: ${DOTFILES_SNIPPETS_ACTION:-}"
    ;;
esac
